        },
        "pfaq_4": {
          "type": "faq_item",
          "settings": {
            "question": "Do you ship internationally?",
            "answer": "<p>Yes, we do ship internationally. Please note that shipping charges will be additional. You can connect with our support team on WhatsApp at +91 77423 77328 for assistance.</p>"
