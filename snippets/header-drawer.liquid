{% comment %}
  Renders a header drawer menu for mobile and desktop.

  Usage:
  {% render 'header-drawer' %}
{% endcomment %}

<header-drawer data-breakpoint="{% if section.settings.menu_type_desktop == 'drawer' %}desktop{% else %}tablet{% endif %}">
  <details id="Details-menu-drawer-container" class="menu-drawer-container">
    <summary
      class="header__icon header__icon--menu header__icon--summary link focus-inset"
      aria-label="{{ 'sections.header.menu' | t }}"
    >
      <span>
        {{- 'icon-hamburger.svg' | inline_asset_content -}}
        {{- 'icon-close.svg' | inline_asset_content -}}
      </span>
    </summary>
    <div id="menu-drawer" class="gradient menu-drawer motion-reduce color-{{ section.settings.menu_color_scheme }}">
      <div class="menu-drawer__inner-container">
        <div class="menu-drawer__navigation-container">
          <nav class="menu-drawer__navigation">
            <ul class="menu-drawer__menu has-submenu list-menu" role="list">
              {%- for link in section.settings.menu.links -%}
                <li>
                  {%- if link.links != blank -%}
                    {%- assign drawer_default_open = false -%}
                    {%- assign top_link_handle = link.title | handleize -%}
                    {%- if link.handle == 'products' or top_link_handle == 'products' -%}
                      {%- assign drawer_default_open = true -%}
                    {%- endif -%}
                    {%- assign top_image = blank -%}
                    {%- if link.object and link.object.featured_image -%}
                      {%- assign top_image = link.object.featured_image -%}
                    {%- elsif link.object and link.object.image -%}
                      {%- assign top_image = link.object.image -%}
                    {%- endif -%}
                    {%- if top_image == blank -%}
                      {%- assign top_handle = link.title | handleize -%}
                      {%- assign top_collection = collections[top_handle] -%}
                      {%- if top_collection and top_collection.featured_image -%}
                        {%- assign top_image = top_collection.featured_image -%}
                      {%- endif -%}
                    {%- endif -%}
                    <details
                      id="Details-menu-drawer-menu-item-{{ forloop.index }}"
                      {% if drawer_default_open %}
                        open
                        data-default-open="true"
                      {% endif %}
                    >
                      <summary
                        id="HeaderDrawer-{{ link.handle }}"
                        class="menu-drawer__menu-item list-menu__item link link--text focus-inset mega-drawer__link{% if link.child_active %} menu-drawer__menu-item--active{% endif %}"
                        aria-expanded="{% if drawer_default_open %}true{% else %}false{% endif %}"
                      >
                        {%- if top_image != blank -%}
                          <span class="mega-drawer__thumb">
                            {{
                              top_image
                              | image_url: width: 140
                              | image_tag:
                                alt: link.title,
                                loading: 'lazy',
                                class: 'mega-drawer__img'
                            }}
                          </span>
                        {%- endif -%}
                        <span class="mega-drawer__text">{{ link.title | escape }}</span>
                        <span class="svg-wrapper">
                          {{- 'icon-arrow.svg' | inline_asset_content -}}
                        </span>
                        <span class="svg-wrapper">
                          {{- 'icon-caret.svg' | inline_asset_content -}}
                        </span>
                      </summary>
                      <div
                        id="link-{{ link.handle | escape }}"
                        class="menu-drawer__submenu has-submenu gradient motion-reduce"
                        tabindex="-1"
                      >
                        <div class="menu-drawer__inner-submenu">
                          <button class="menu-drawer__close-button link link--text focus-inset" aria-expanded="true">
                            <span class="svg-wrapper">
                              {{- 'icon-arrow.svg' | inline_asset_content -}}
                            </span>
                            {{ link.title | escape }}
                          </button>
                          <ul class="menu-drawer__menu list-menu" role="list" tabindex="-1">
                            {%- for childlink in link.links -%}
                              <li>
                                {%- if childlink.links == blank -%}
                                  {%- assign child_image = blank -%}
                                  {%- if childlink.metafields.custom.mega_image != blank -%}
                                    {%- assign child_image = childlink.metafields.custom.mega_image -%}
                                  {%- elsif childlink.object and childlink.object.featured_image -%}
                                    {%- assign child_image = childlink.object.featured_image -%}
                                  {%- elsif childlink.object and childlink.object.image -%}
                                    {%- assign child_image = childlink.object.image -%}
                                  {%- endif -%}
                                  {%- if child_image == blank -%}
                                    {%- assign child_handle = childlink.title | handleize -%}
                                    {%- assign child_collection = collections[child_handle] -%}
                                    {%- if child_collection and child_collection.featured_image -%}
                                      {%- assign child_image = child_collection.featured_image -%}
                                    {%- endif -%}
                                  {%- endif -%}
                                  <a
                                    id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}"
                                    href="{{ childlink.url }}"
                                    class="menu-drawer__menu-item link link--text list-menu__item focus-inset mega-drawer__link{% if childlink.current %} menu-drawer__menu-item--active{% endif %}"
                                    {% if childlink.current %}
                                      aria-current="page"
                                    {% endif %}
                                  >
                                    {%- if child_image != blank -%}
                                      <span class="mega-drawer__thumb">
                                        {{
                                          child_image
                                          | image_url: width: 140
                                          | image_tag:
                                            alt: childlink.title,
                                            loading: 'lazy',
                                            class: 'mega-drawer__img'
                                        }}
                                      </span>
                                    {%- endif -%}
                                    <span class="mega-drawer__text">{{ childlink.title | escape }}</span>
                                  </a>
                                {%- else -%}
                                  {%- assign child_sub_image = blank -%}
                                  {%- if childlink.metafields.custom.mega_image != blank -%}
                                    {%- assign child_sub_image = childlink.metafields.custom.mega_image -%}
                                  {%- elsif childlink.object and childlink.object.featured_image -%}
                                    {%- assign child_sub_image = childlink.object.featured_image -%}
                                  {%- elsif childlink.object and childlink.object.image -%}
                                    {%- assign child_sub_image = childlink.object.image -%}
                                  {%- endif -%}
                                  {%- if child_sub_image == blank -%}
                                    {%- assign child_sub_handle = childlink.title | handleize -%}
                                    {%- assign child_sub_collection = collections[child_sub_handle] -%}
                                    {%- if child_sub_collection and child_sub_collection.featured_image -%}
                                      {%- assign child_sub_image = child_sub_collection.featured_image -%}
                                    {%- endif -%}
                                  {%- endif -%}
                                  <details id="Details-menu-drawer-{{ link.handle }}-{{ childlink.handle }}">
                                    <summary
                                      id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}"
                                      class="menu-drawer__menu-item link link--text list-menu__item focus-inset mega-drawer__link"
                                    >
                                      {%- if child_sub_image != blank -%}
                                        <span class="mega-drawer__thumb">
                                          {{
                                            child_sub_image
                                            | image_url: width: 140
                                            | image_tag:
                                              alt: childlink.title,
                                              loading: 'lazy',
                                              class: 'mega-drawer__img'
                                          }}
                                        </span>
                                      {%- endif -%}
                                      <span class="mega-drawer__text">{{ childlink.title | escape }}</span>
                                      <span class="svg-wrapper">
                                        {{- 'icon-arrow.svg' | inline_asset_content -}}
                                      </span>
                                      <span class="svg-wrapper">
                                        {{- 'icon-caret.svg' | inline_asset_content -}}
                                      </span>
                                    </summary>
                                    <div
                                      id="childlink-{{ childlink.handle | escape }}"
                                      class="menu-drawer__submenu has-submenu gradient motion-reduce"
                                    >
                                      <button
                                        class="menu-drawer__close-button link link--text focus-inset"
                                        aria-expanded="true"
                                      >
                                        <span class="svg-wrapper">
                                          {{- 'icon-arrow.svg' | inline_asset_content -}}
                                        </span>
                                        {{ childlink.title | escape }}
                                      </button>
                                      <ul
                                        class="menu-drawer__menu list-menu"
                                        role="list"
                                        tabindex="-1"
                                      >
                                        {%- for grandchildlink in childlink.links -%}
                                          <li>
                                            {%- assign grandchild_image = blank -%}
                                            {%- if grandchildlink.metafields.custom.mega_image != blank -%}
                                              {%- assign grandchild_image = grandchildlink.metafields.custom.mega_image -%}
                                            {%- elsif grandchildlink.object and grandchildlink.object.featured_image -%}
                                              {%- assign grandchild_image = grandchildlink.object.featured_image -%}
                                            {%- elsif grandchildlink.object and grandchildlink.object.image -%}
                                              {%- assign grandchild_image = grandchildlink.object.image -%}
                                            {%- endif -%}
                                            {%- if grandchild_image == blank -%}
                                              {%- assign grandchild_handle = grandchildlink.title | handleize -%}
                                              {%- assign grandchild_collection = collections[grandchild_handle] -%}
                                              {%- if grandchild_collection and grandchild_collection.featured_image -%}
                                                {%- assign grandchild_image = grandchild_collection.featured_image -%}
                                              {%- endif -%}
                                            {%- endif -%}
                                            <a
                                              id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                                              href="{{ grandchildlink.url }}"
                                              class="menu-drawer__menu-item link link--text list-menu__item focus-inset mega-drawer__link{% if grandchildlink.current %} menu-drawer__menu-item--active{% endif %}"
                                              {% if grandchildlink.current %}
                                                aria-current="page"
                                              {% endif %}
                                            >
                                              {%- if grandchild_image != blank -%}
                                                <span class="mega-drawer__thumb">
                                                  {{
                                                    grandchild_image
                                                    | image_url: width: 120
                                                    | image_tag:
                                                      alt: grandchildlink.title,
                                                      loading: 'lazy',
                                                      class: 'mega-drawer__img'
                                                  }}
                                                </span>
                                              {%- endif -%}
                                              <span class="mega-drawer__text">{{ grandchildlink.title | escape }}</span>
                                            </a>
                                          </li>
                                        {%- endfor -%}
                                      </ul>
                                    </div>
                                  </details>
                                {%- endif -%}
                              </li>
                            {%- endfor -%}
                          </ul>
                        </div>
                      </div>
                    </details>
                  {%- else -%}
                    <a
                      id="HeaderDrawer-{{ link.handle }}"
                      href="{{ link.url }}"
                      class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.current %} menu-drawer__menu-item--active{% endif %}"
                      {% if link.current %}
                        aria-current="page"
                      {% endif %}
                    >
                      {{ link.title | escape }}
                    </a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </nav>
          <div class="menu-drawer__utility-links">
            {%- if shop.customer_accounts_enabled -%}
              <a
                href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
                class="menu-drawer__account link focus-inset h5 medium-hide large-up-hide"
                rel="nofollow"
              >
                {%- if section.settings.enable_customer_avatar -%}
                  <account-icon>
                    {%- if customer and customer.has_avatar? -%}
                      {{ customer | avatar }}
                    {%- else -%}
                      <span class="svg-wrapper">
                        {{- 'icon-account.svg' | inline_asset_content -}}
                      </span>
                    {%- endif -%}
                  </account-icon>
                {%- else -%}
                  <span class="svg-wrapper">
                    {{- 'icon-account.svg' | inline_asset_content -}}
                  </span>
                {%- endif -%}
                {%- liquid
                  if customer
                    echo 'customer.account_fallback' | t
                  else
                    echo 'customer.log_in' | t
                  endif
                -%}
              </a>
            {%- endif -%}
            {%- if localization.available_countries or localization.available_languages -%}
              <div class="menu-drawer__localization header-localization">
                {%- if localization.available_countries and localization.available_countries.size > 1 -%}
                  <localization-form>
                    {%- form 'localization', id: 'HeaderCountryMobileForm', class: 'localization-form' -%}
                      <div>
                        <h2 class="visually-hidden" id="HeaderCountryMobileLabel">
                          {{ 'localization.country_label' | t }}
                        </h2>
                        {%- render 'country-localization', localPosition: 'HeaderCountryMobile' -%}
                      </div>
                    {%- endform -%}
                  </localization-form>
                {% endif %}

                {%- if localization.available_languages and localization.available_languages.size > 1 -%}
                  <localization-form>
                    {%- form 'localization', id: 'HeaderLanguageMobileForm', class: 'localization-form' -%}
                      <div>
                        <h2 class="visually-hidden" id="HeaderLanguageMobileLabel">
                          {{ 'localization.language_label' | t }}
                        </h2>
                        {%- render 'language-localization', localPosition: 'HeaderLanguageMobile' -%}
                      </div>
                    {%- endform -%}
                  </localization-form>
                {%- endif -%}
              </div>
            {%- endif -%}
            <ul class="list list-social list-unstyled" role="list">
              {%- if settings.social_twitter_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_twitter_link }}" class="list-social__link link">
                    <span class="svg-wrapper">
                      {{- 'icon-twitter.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'general.social.links.twitter' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_facebook_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_facebook_link }}" class="list-social__link link">
                    <span class="svg-wrapper">
                      {{- 'icon-facebook.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'general.social.links.facebook' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_pinterest_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_pinterest_link }}" class="list-social__link link">
                    <span class="svg-wrapper">
                      {{- 'icon-pinterest.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'general.social.links.pinterest' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_instagram_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_instagram_link }}" class="list-social__link link">
                    <span class="svg-wrapper">
                      {{- 'icon-instagram.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'general.social.links.instagram' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_tiktok_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_tiktok_link }}" class="list-social__link link">
                    <span class="svg-wrapper">
                      {{- 'icon-tiktok.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'general.social.links.tiktok' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_tumblr_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_tumblr_link }}" class="list-social__link link">
                    <span class="svg-wrapper">
                      {{- 'icon-tumblr.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'general.social.links.tumblr' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_snapchat_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_snapchat_link }}" class="list-social__link link">
                    <span class="svg-wrapper">
                      {{- 'icon-snapchat.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'general.social.links.snapchat' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_youtube_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_youtube_link }}" class="list-social__link link">
                    <span class="svg-wrapper">
                      {{- 'icon-youtube.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'general.social.links.youtube' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_vimeo_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_vimeo_link }}" class="list-social__link link">
                    <span class="svg-wrapper">
                      {{- 'icon-vimeo.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'general.social.links.vimeo' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </details>
</header-drawer>
