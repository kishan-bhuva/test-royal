{%- liquid
  assign show_date_metafield = blank
  assign timeline_enabled_in_theme = section.settings.show_delivery_timeline | default: true, allow_false: true
  assign timeline_visible = false
  assign processing_days_value = section.settings.delivery_timeline_processing_days | default: 3
  assign processing_metafield = blank
  assign processing_raw_value = blank
  assign processing_end_date_value = blank

  if product
    assign show_date_metafield = product.metafields.custom.show_date_field

    if show_date_metafield == blank
      assign show_date_metafield = product.metafields.custom.show_date
    endif

    if timeline_enabled_in_theme and show_date_metafield != blank
      assign timeline_visible = show_date_metafield.value | default: false, allow_false: true
    endif

    assign processing_metafield = product.metafields.custom.processing_end_date_field

    if processing_metafield == blank
      assign processing_metafield = product.metafields.custom.processing_end_date
    endif

    if processing_metafield == blank
      assign processing_metafield = product.metafields.custom.processing_days
    endif

    if processing_metafield != blank
      assign processing_raw_value = processing_metafield.value

      if processing_metafield.type contains 'date'
        assign processing_end_date_value = processing_raw_value | date: '%Y-%m-%d'
      else
        assign processing_days_value = processing_raw_value | default: processing_days_value
      endif
    endif
  endif
-%}

{%- if product and timeline_visible -%}
  <style>
    .rg-product-timeline--{{ section.id }} {
      position: relative;
      overflow: hidden;
      isolation: isolate;
      margin: 0;
      padding: 22px 18px 18px;
      border: 1px solid rgba(212, 175, 55, 0.18);
      border-radius: 24px;
      background:
        radial-gradient(circle at top right, rgba(212, 175, 55, 0.15) 0%, rgba(212, 175, 55, 0) 30%),
        radial-gradient(circle at bottom left, rgba(17, 48, 37, 0.34) 0%, rgba(17, 48, 37, 0) 38%),
        linear-gradient(145deg, #102018 0%, #0a1510 52%, #060907 100%);
      box-shadow: 0 24px 54px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.03);
      color: #f2ecdf;
    }

    .rg-product-timeline--{{ section.id }}::before,
    .rg-product-timeline--{{ section.id }}::after {
      content: '';
      position: absolute;
      border-radius: 999px;
      pointer-events: none;
      z-index: -1;
    }

    .rg-product-timeline--{{ section.id }}::before {
      top: -120px;
      right: -70px;
      width: 240px;
      height: 240px;
      background: radial-gradient(circle, rgba(212, 175, 55, 0.14) 0%, rgba(212, 175, 55, 0) 72%);
    }

    .rg-product-timeline--{{ section.id }}::after {
      bottom: -110px;
      left: -60px;
      width: 220px;
      height: 220px;
      background: radial-gradient(circle, rgba(22, 61, 44, 0.28) 0%, rgba(22, 61, 44, 0) 72%);
    }

    .rg-product-timeline--{{ section.id }} .rg-product-timeline__header {
      display: grid;
      gap: 14px;
      margin-bottom: 18px;
    }

    .rg-product-timeline--{{ section.id }} .rg-product-timeline__eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      width: fit-content;
      margin: 0;
      padding: 6px 11px;
      border-radius: 999px;
      background: rgba(212, 175, 55, 0.09);
      border: 1px solid rgba(212, 175, 55, 0.14);
      color: #d4af37;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .rg-product-timeline--{{ section.id }} .rg-product-timeline__dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #d4af37;
      box-shadow: 0 0 0 5px rgba(212, 175, 55, 0.12);
    }

    .rg-product-timeline--{{ section.id }} .rg-product-timeline__title {
      margin: 0;
      font-family: 'Playfair Display', Georgia, serif;
      font-size: clamp(24px, 2.5vw, 30px);
      line-height: 1.2;
      color: #f6f0e4;
    }

    .rg-product-timeline--{{ section.id }} .rg-product-timeline__subtitle {
      margin: 6px 0 0;
      color: rgba(223, 230, 222, 0.72);
      font-size: 13px;
      line-height: 1.55;
    }

    .rg-product-timeline--{{ section.id }} .rg-product-timeline__steps {
      --timeline-rail-x: 28px;
      position: relative;
      display: grid;
      gap: 16px;
      isolation: isolate;
    }

    .rg-product-timeline--{{ section.id }} .rg-product-timeline__steps::before {
      content: '';
      position: absolute;
      left: var(--timeline-rail-x);
      top: 24px;
      bottom: 24px;
      width: 1px;
      background: linear-gradient(180deg, rgba(212, 175, 55, 0.45) 0%, rgba(212, 175, 55, 0.12) 100%);
      pointer-events: none;
      z-index: 0;
    }

    .rg-product-timeline--{{ section.id }} .rg-product-timeline__step {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: 58px minmax(0, 1fr);
      gap: 0 16px;
      align-items: start;
      padding: 16px;
      border-radius: 20px;
      background: linear-gradient(180deg, rgba(15, 28, 21, 0.96) 0%, rgba(9, 18, 14, 0.98) 100%);
      border: 1px solid rgba(212, 175, 55, 0.12);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03), 0 12px 26px rgba(0, 0, 0, 0.24);
      transition: transform 0.28s ease, border-color 0.28s ease, box-shadow 0.28s ease;
    }

    .rg-product-timeline--{{ section.id }} .rg-product-timeline__step:hover {
      transform: translateY(-3px);
      border-color: rgba(212, 175, 55, 0.24);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03), 0 16px 28px rgba(0, 0, 0, 0.28);
    }

    .rg-product-timeline--{{ section.id }} .rg-product-timeline__step--processing {
      background: linear-gradient(180deg, rgba(17, 34, 25, 0.96) 0%, rgba(10, 19, 15, 0.98) 100%);
    }

    .rg-product-timeline--{{ section.id }} .rg-product-timeline__step--delivery {
      background: linear-gradient(180deg, rgba(18, 31, 23, 0.96) 0%, rgba(9, 18, 14, 0.98) 100%);
    }

    .rg-product-timeline--{{ section.id }} .rg-product-timeline__icon {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 58px;
      height: 58px;
      border-radius: 18px;
      border: 1px solid rgba(212, 175, 55, 0.2);
      background: linear-gradient(145deg, rgba(212, 175, 55, 0.18) 0%, rgba(20, 39, 29, 0.94) 55%, rgba(8, 14, 11, 0.98) 100%);
      color: #e1bf5b;
      box-shadow: 0 14px 30px rgba(0, 0, 0, 0.28), inset 0 1px 0 rgba(255, 255, 255, 0.08);
      isolation: isolate;
    }

    .rg-product-timeline--{{ section.id }} .rg-product-timeline__icon::before {
      content: '';
      position: absolute;
      inset: -8px;
      border-radius: 22px;
      border: 1px solid rgba(212, 175, 55, 0.08);
      background: radial-gradient(circle, rgba(212, 175, 55, 0.12) 0%, rgba(212, 175, 55, 0) 72%);
      z-index: -2;
    }

    .rg-product-timeline--{{ section.id }} .rg-product-timeline__icon::after {
      content: '';
      position: absolute;
      inset: 10px;
      border-radius: 14px;
      background: radial-gradient(circle at 30% 30%, rgba(212, 175, 55, 0.24) 0%, rgba(212, 175, 55, 0) 75%);
      z-index: -1;
    }

    .rg-product-timeline--{{ section.id }} .rg-product-timeline__icon svg {
      width: 24px;
      height: 24px;
      display: block;
      position: relative;
      z-index: 1;
    }

    .rg-product-timeline--{{ section.id }} .rg-product-timeline__meta {
      min-width: 0;
    }

    .rg-product-timeline--{{ section.id }} .rg-product-timeline__label {
      margin: 0 0 4px;
      color: #d4af37;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .rg-product-timeline--{{ section.id }} .rg-product-timeline__date {
      margin: 0;
      color: #f6f0e4;
      font-size: clamp(18px, 2vw, 20px);
      font-weight: 700;
      line-height: 1.35;
    }

    .rg-product-timeline--{{ section.id }} .rg-product-timeline__hint {
      margin: 6px 0 0;
      color: rgba(223, 230, 222, 0.68);
      font-size: 12px;
      line-height: 1.5;
    }

    @media screen and (max-width: 749px) {
      .rg-product-timeline--{{ section.id }} {
        padding: 20px 16px 16px;
      }

      .rg-product-timeline--{{ section.id }} .rg-product-timeline__steps {
        --timeline-rail-x: 26px;
        gap: 14px;
      }

      .rg-product-timeline--{{ section.id }} .rg-product-timeline__step {
        grid-template-columns: 52px minmax(0, 1fr);
        gap: 0 14px;
        padding: 15px;
      }

      .rg-product-timeline--{{ section.id }} .rg-product-timeline__icon {
        width: 52px;
        height: 52px;
        border-radius: 16px;
      }
    }
  </style>

  <div
    class="rg-product-timeline rg-product-timeline--{{ section.id }}"
    data-rg-product-timeline
    data-processing-days="{{ processing_days_value | escape }}"
    data-processing-fallback="{{ section.settings.delivery_timeline_processing_days | default: 3 | escape }}"
    data-processing-raw="{{ processing_raw_value | escape }}"
    data-processing-end-date="{{ processing_end_date_value | escape }}"
    data-delivery-days="{{ section.settings.delivery_timeline_delivery_duration | default: 7 | escape }}"
    aria-label="Delivery timeline"
  >
    <div class="rg-product-timeline__header">
      <div>
        <p class="rg-product-timeline__eyebrow">
          <span class="rg-product-timeline__dot" aria-hidden="true"></span>
          Delivery timeline
        </p>
        <h2 class="rg-product-timeline__title">Delivery estimate for this order</h2>
        <p class="rg-product-timeline__subtitle">Your order moves from confirmation to dispatch and then delivery. Estimated dates are shown below.</p>
      </div>
    </div>

    <div class="rg-product-timeline__steps" role="list">
      <article class="rg-product-timeline__step rg-product-timeline__step--ordered" role="listitem">
        <span class="rg-product-timeline__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M9.75 3.5h4.5A1.25 1.25 0 0 1 15.5 4.75V6h1.25a1.75 1.75 0 0 1 1.75 1.75v10.5A1.75 1.75 0 0 1 16.75 20H7.25A1.75 1.75 0 0 1 5.5 18.25V7.75A1.75 1.75 0 0 1 7.25 6H8.5V4.75A1.25 1.25 0 0 1 9.75 3.5Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M9.5 6h5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <path d="m9.4 12.15 1.75 1.75 3.45-3.65" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <div class="rg-product-timeline__meta">
          <p class="rg-product-timeline__label">Ordered</p>
          <p class="rg-product-timeline__date" data-timeline-role="ordered" aria-live="polite"></p>
          <p class="rg-product-timeline__hint">Your order is received and queued for production.</p>
        </div>
      </article>

      <article class="rg-product-timeline__step rg-product-timeline__step--processing" role="listitem">
        <span class="rg-product-timeline__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M12 4.25 13.76 7.6l3.74.54-2.7 2.63.64 3.73L12 12.73 8.56 14.5l.64-3.73-2.7-2.63 3.74-.54L12 4.25Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M17.5 14.75 18.1 16l1.4.7-1.4.7-.6 1.35-.65-1.35-1.35-.7 1.35-.7.65-1.25Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <div class="rg-product-timeline__meta">
          <p class="rg-product-timeline__label">Processing</p>
          <p class="rg-product-timeline__date" data-timeline-role="processing" aria-live="polite"></p>
          <p class="rg-product-timeline__hint">We prepare, customize, quality-check, and pack your order.</p>
        </div>
      </article>

      <article class="rg-product-timeline__step rg-product-timeline__step--delivery" role="listitem">
        <span class="rg-product-timeline__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M4 8.25h9.75v6.75H4V8.25Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
            <path d="M13.75 10.5h2.95c.54 0 1.04.25 1.36.68l1.19 1.57c.18.24.28.53.28.83V15h-5.78v-4.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
            <path d="M6 17a1.75 1.75 0 1 0 0-3.5A1.75 1.75 0 0 0 6 17Zm11 0a1.75 1.75 0 1 0 0-3.5A1.75 1.75 0 0 0 17 17Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
            <path d="M5 10.5H2.75M6 12.75H4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
        </span>
        <div class="rg-product-timeline__meta">
          <p class="rg-product-timeline__label">Delivery</p>
          <p class="rg-product-timeline__date" data-timeline-role="delivery" aria-live="polite"></p>
          <p class="rg-product-timeline__hint">Your parcel is dispatched and travels to your address.</p>
        </div>
      </article>
    </div>
  </div>

  <script>
    window.RGProductDeliveryTimeline = window.RGProductDeliveryTimeline || (function () {
      const formatter = new Intl.DateTimeFormat('en-US', { month: 'short', day: '2-digit' });

      function addDays(date, days) {
        const nextDate = new Date(date);
        nextDate.setDate(nextDate.getDate() + days);
        return nextDate;
      }

      function normalizeDays(value, fallback) {
        const parsedValue = Math.round(Number(value));
        return Number.isFinite(parsedValue) && parsedValue > 0 ? parsedValue : fallback;
      }

      function normalizeDate(date) {
        const normalizedDate = new Date(date);
        normalizedDate.setHours(12, 0, 0, 0);
        return normalizedDate;
      }

      function parseMetafieldDate(value) {
        const rawValue = String(value || '').trim();

        if (!rawValue || /^-?\d+(\.\d+)?$/.test(rawValue)) return null;

        const parsedDate = new Date(rawValue);
        if (!Number.isFinite(parsedDate.getTime())) return null;

        return normalizeDate(parsedDate);
      }

      function formatRange(startDate, endDate) {
        return formatter.format(startDate) + ' - ' + formatter.format(endDate);
      }

      function render(root) {
        if (!root) return;

        const fallbackProcessingDays = normalizeDays(root.dataset.processingFallback, 3);
        const metafieldProcessingDate =
          parseMetafieldDate(root.dataset.processingEndDate) ||
          parseMetafieldDate(root.dataset.processingRaw);
        const processingDays = normalizeDays(root.dataset.processingDays, fallbackProcessingDays);
        const deliveryDays = normalizeDays(root.dataset.deliveryDays, 7);
        const today = normalizeDate(new Date());
        const processingStart = addDays(today, 1);
        let processingEnd = metafieldProcessingDate || addDays(today, processingDays);

        if (processingEnd < processingStart) processingEnd = processingStart;

        const deliveryStart = addDays(processingEnd, 1);
        const deliveryEnd = addDays(processingEnd, deliveryDays);

        const ordered = root.querySelector('[data-timeline-role="ordered"]');
        const processing = root.querySelector('[data-timeline-role="processing"]');
        const delivery = root.querySelector('[data-timeline-role="delivery"]');

        if (ordered) ordered.textContent = formatter.format(today);
        if (processing) {
          processing.textContent = metafieldProcessingDate
            ? formatter.format(processingEnd)
            : formatRange(processingStart, processingEnd);
        }
        if (delivery) delivery.textContent = formatRange(deliveryStart, deliveryEnd);
      }

      function init(scope) {
        const target = scope || document;
        if (target.nodeType === 1 && target.hasAttribute('data-rg-product-timeline')) render(target);
        if (target.querySelectorAll) {
          target.querySelectorAll('[data-rg-product-timeline]').forEach(render);
        }
      }

      document.addEventListener('shopify:section:load', function (event) {
        init(event.target);
      });

      return { init: init };
    })();

    window.RGProductDeliveryTimeline.init(document);
  </script>
{%- endif -%}
