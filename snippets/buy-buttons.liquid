{% comment %}
  Renders product buy-buttons.
  Accepts:
  - product: {Object} product object.
  - block: {Object} passing the block information.
  - product_form_id: {String} product form id.
  - section_id: {String} id of section to which this snippet belongs.
  - show_pickup_availability: {Boolean} for the pickup availability. If true the pickup availability is rendered, false - not rendered (optional).

  Usage:
  {% render 'buy-buttons', block: block, product: product, product_form_id: product_form_id, section_id: section.id, show_pickup_availability: true %}
{% endcomment %}
<div {{ block.shopify_attributes }}>
  {%- if product != blank -%}
    {%- liquid
      assign gift_card_recipient_feature_active = false
      if block.settings.show_gift_card_recipient and product.gift_card?
        assign gift_card_recipient_feature_active = true
      endif

      assign show_dynamic_checkout = false
      if block.settings.show_dynamic_checkout and gift_card_recipient_feature_active == false
        assign show_dynamic_checkout = true
      endif
    -%}

    <product-form
      class="product-form"
      data-hide-errors="{{ gift_card_recipient_feature_active }}"
      data-section-id="{{ section.id }}"
    >
      <div class="product-form__error-message-wrapper" role="alert" hidden>
        <span class="svg-wrapper">
          {{- 'icon-error.svg' | inline_asset_content -}}
        </span>
        <span class="product-form__error-message"></span>
      </div>

      {%- form 'product',
        product,
        id: product_form_id,
        class: 'form',
        novalidate: 'novalidate',
        data-type: 'add-to-cart-form'
      -%}
        <input
          type="hidden"
          name="id"
          value="{{ product.selected_or_first_available_variant.id }}"
          {% if product.selected_or_first_available_variant.available == false
            or quantity_rule_soldout
            or product.selected_or_first_available_variant == null
          %}
            disabled
          {% endif %}
          class="product-variant-id"
        >

        {%- if gift_card_recipient_feature_active -%}
          {%- render 'gift-card-recipient-form', product: product, form: form, section: section -%}
        {%- endif -%}

        {%- assign show_personalisation = true -%}
        {%- assign in_metal_name_plates = false -%}
        {%- for col in product.collections -%}
          {%- if col.handle == 'metal-wall-art' -%}
            {%- assign show_personalisation = false -%}
            {%- break -%}
          {%- endif -%}
          {%- if col.handle == 'metal-name-plates' -%}
            {%- assign in_metal_name_plates = true -%}
          {%- endif -%}
        {%- endfor -%}

        {%- assign show_name = product.metafields.custom.show_name.value | default: false, allow_false: true -%}
        {%- assign show_surname = product.metafields.custom.show_surname.value | default: false, allow_false: true -%}
        {%- assign show_house_no = product.metafields.custom.show_house_no.value | default: false, allow_false: true -%}
        {%- assign show_details = product.metafields.custom.show_details.value | default: false, allow_false: true -%}
        {%- assign show_instructions = product.metafields.custom.show_instructions.value | default: false, allow_false: true -%}
        {%- assign show_color = product.metafields.custom.show_color.value | default: false, allow_false: true -%}
        {%- assign has_visible_personalisation_fields = false -%}
        {%- if show_name or show_surname or show_house_no or show_details or show_instructions -%}
          {%- assign has_visible_personalisation_fields = true -%}
        {%- endif -%}
        {%- if show_color -%}
          {%- assign has_visible_personalisation_fields = true -%}
        {%- endif -%}

        {%- if show_personalisation and has_visible_personalisation_fields -%}
          <div class="nameplate-fields" data-nameplate-properties>
            <h3 class="nameplate-fields__heading">Personalisation Details</h3>

            <div class="nameplate-fields__grid">
              {%- if show_name -%}
              <div
                class="nameplate-field"
                data-property-wrapper
                data-property-name="properties[Name]"
                data-property-required="true"
              >
                <label class="nameplate-field__label" for="np-name-{{ section_id }}">
                  Enter Your Name/Surname <span class="nameplate-field__required" aria-hidden="true">*</span>
                </label>
                <input
                  id="np-name-{{ section_id }}"
                  class="nameplate-field__input"
                  type="text"
                  name="properties[Name]"
                  placeholder="e.g. Ali Asgar"
                  autocomplete="off"
                  required
                  aria-describedby="np-name-error-{{ section_id }}"
                >
                <p class="nameplate-field__error" id="np-name-error-{{ section_id }}" hidden role="alert">
                  Please enter Name.
                </p>
              </div>
              {%- endif -%}

              {%- if show_surname -%}
              <div
                class="nameplate-field"
                data-property-wrapper
                data-property-name="properties[Surname]"
                data-property-required="true"
              >
                <label class="nameplate-field__label" for="np-surname-{{ section_id }}">
                  Surname <span class="nameplate-field__required" aria-hidden="true">*</span>
                </label>
                <input
                  id="np-surname-{{ section_id }}"
                  class="nameplate-field__input"
                  type="text"
                  name="properties[Surname]"
                  placeholder="Enter the surname for your plate"
                  autocomplete="off"
                  required
                  aria-describedby="np-surname-error-{{ section_id }}"
                >
                <p class="nameplate-field__error" id="np-surname-error-{{ section_id }}" hidden role="alert">
                  Please enter Surname.
                </p>
              </div>
              {%- endif -%}

              {%- if show_house_no -%}
              <div
                class="nameplate-field"
                data-property-wrapper
                data-property-name="properties[House No]"
                data-property-required="true"
              >
                <label class="nameplate-field__label" for="np-house-{{ section_id }}">
                  Enter House/Flat No <span class="nameplate-field__required" aria-hidden="true">*</span>
                </label>
                <input
                  id="np-house-{{ section_id }}"
                  class="nameplate-field__input"
                  type="text"
                  name="properties[House No]"
                  placeholder="e.g. 12A, Flat 301"
                  autocomplete="off"
                  required
                  aria-describedby="np-house-error-{{ section_id }}"
                >
                <p class="nameplate-field__error" id="np-house-error-{{ section_id }}" hidden role="alert">
                  Please enter House No.
                </p>
              </div>
              {%- endif -%}

              {%- if show_details -%}
              <div
                class="nameplate-field"
                data-property-wrapper
                data-property-name="properties[Details]"
                data-property-required="true"
              >
                <label class="nameplate-field__label" for="np-details-{{ section_id }}">
                  Enter Details <span class="nameplate-field__required" aria-hidden="true">*</span>
                </label>
                <input
                  id="np-details-{{ section_id }}"
                  class="nameplate-field__input"
                  type="text"
                  name="properties[Details]"
                  placeholder="Enter detail text for your nameplate"
                  autocomplete="off"
                  required
                  aria-describedby="np-details-error-{{ section_id }}"
                >
                <p class="nameplate-field__error" id="np-details-error-{{ section_id }}" hidden role="alert">
                  Please enter Details.
                </p>
              </div>
              {%- endif -%}

              {%- if show_instructions -%}
              <div
                class="nameplate-field"
                data-property-wrapper
                data-property-name="properties[Instructions]"
              >
                <label class="nameplate-field__label" for="np-instructions-{{ section_id }}">
                  Instructions
                </label>
                <textarea
                  id="np-instructions-{{ section_id }}"
                  class="nameplate-field__textarea"
                  name="properties[Instructions]"
                  placeholder="Special instructions for our team..."
                  rows="3"
                ></textarea>
              </div>
              {%- endif -%}
            </div>

            {%- if show_color -%}
            <fieldset
              class="nameplate-field nameplate-field--swatch"
              data-property-wrapper
              data-property-name="properties[Choose Color]"
              data-property-required="true"
            >
              <legend class="nameplate-field__label">
                Choose Color <span class="nameplate-field__required" aria-hidden="true">*</span>
              </legend>
              <div class="nameplate-swatch-group" role="radiogroup" aria-describedby="np-color-error-{{ section_id }}">
                <label class="nameplate-swatch" for="np-color-sparkle-gold-{{ section_id }}">
                  <input
                    id="np-color-sparkle-gold-{{ section_id }}"
                    class="nameplate-swatch__radio"
                    type="radio"
                    name="properties[Choose Color]"
                    value="Sparkle Gold"
                    required
                  >
                  <span class="nameplate-swatch__chip nameplate-swatch__chip--sparkle-gold" aria-hidden="true"></span>
                  <span class="nameplate-swatch__text">Sparkle Gold</span>
                </label>

                <label class="nameplate-swatch" for="np-color-antique-gold-{{ section_id }}">
                  <input
                    id="np-color-antique-gold-{{ section_id }}"
                    class="nameplate-swatch__radio"
                    type="radio"
                    name="properties[Choose Color]"
                    value="Antique Gold"
                  >
                  <span class="nameplate-swatch__chip nameplate-swatch__chip--antique-gold" aria-hidden="true"></span>
                  <span class="nameplate-swatch__text">Antique Gold</span>
                </label>

                <label class="nameplate-swatch" for="np-color-antique-silver-{{ section_id }}">
                  <input
                    id="np-color-antique-silver-{{ section_id }}"
                    class="nameplate-swatch__radio"
                    type="radio"
                    name="properties[Choose Color]"
                    value="Antique Silver"
                  >
                  <span class="nameplate-swatch__chip nameplate-swatch__chip--antique-silver" aria-hidden="true"></span>
                  <span class="nameplate-swatch__text">Antique Silver</span>
                </label>

                <label class="nameplate-swatch" for="np-color-black-matte-{{ section_id }}">
                  <input
                    id="np-color-black-matte-{{ section_id }}"
                    class="nameplate-swatch__radio"
                    type="radio"
                    name="properties[Choose Color]"
                    value="Black Matte"
                  >
                  <span class="nameplate-swatch__chip nameplate-swatch__chip--black-matte" aria-hidden="true"></span>
                  <span class="nameplate-swatch__text">Black Matte</span>
                </label>

                <label class="nameplate-swatch" for="np-color-crocodile-blue-{{ section_id }}">
                  <input
                    id="np-color-crocodile-blue-{{ section_id }}"
                    class="nameplate-swatch__radio"
                    type="radio"
                    name="properties[Choose Color]"
                    value="Crocodile Blue"
                  >
                  <span class="nameplate-swatch__chip nameplate-swatch__chip--crocodile-blue" aria-hidden="true"></span>
                  <span class="nameplate-swatch__text">Crocodile Blue</span>
                </label>

                <label class="nameplate-swatch" for="np-color-gunmetal-grey-{{ section_id }}">
                  <input
                    id="np-color-gunmetal-grey-{{ section_id }}"
                    class="nameplate-swatch__radio"
                    type="radio"
                    name="properties[Choose Color]"
                    value="Gunmetal Grey"
                  >
                  <span class="nameplate-swatch__chip nameplate-swatch__chip--gunmetal-grey" aria-hidden="true"></span>
                  <span class="nameplate-swatch__text">Gunmetal Grey</span>
                </label>

                <label class="nameplate-swatch" for="np-color-metallic-brown-{{ section_id }}">
                  <input
                    id="np-color-metallic-brown-{{ section_id }}"
                    class="nameplate-swatch__radio"
                    type="radio"
                    name="properties[Choose Color]"
                    value="Metallic Brown"
                  >
                  <span class="nameplate-swatch__chip nameplate-swatch__chip--metallic-brown" aria-hidden="true"></span>
                  <span class="nameplate-swatch__text">Metallic Brown</span>
                </label>

                <label class="nameplate-swatch" for="np-color-metallic-green-{{ section_id }}">
                  <input
                    id="np-color-metallic-green-{{ section_id }}"
                    class="nameplate-swatch__radio"
                    type="radio"
                    name="properties[Choose Color]"
                    value="Metallic Green"
                  >
                  <span class="nameplate-swatch__chip nameplate-swatch__chip--metallic-green" aria-hidden="true"></span>
                  <span class="nameplate-swatch__text">Metallic Green</span>
                </label>

                <label class="nameplate-swatch" for="np-color-silver-{{ section_id }}">
                  <input
                    id="np-color-silver-{{ section_id }}"
                    class="nameplate-swatch__radio"
                    type="radio"
                    name="properties[Choose Color]"
                    value="Silver"
                  >
                  <span class="nameplate-swatch__chip nameplate-swatch__chip--silver" aria-hidden="true"></span>
                  <span class="nameplate-swatch__text">Silver</span>
                </label>

                <label class="nameplate-swatch" for="np-color-special-copper-{{ section_id }}">
                  <input
                    id="np-color-special-copper-{{ section_id }}"
                    class="nameplate-swatch__radio"
                    type="radio"
                    name="properties[Choose Color]"
                    value="Special Copper"
                  >
                  <span class="nameplate-swatch__chip nameplate-swatch__chip--special-copper" aria-hidden="true"></span>
                  <span class="nameplate-swatch__text">Special Copper</span>
                </label>

                <label class="nameplate-swatch" for="np-color-special-gold-{{ section_id }}">
                  <input
                    id="np-color-special-gold-{{ section_id }}"
                    class="nameplate-swatch__radio"
                    type="radio"
                    name="properties[Choose Color]"
                    value="Special Gold"
                  >
                  <span class="nameplate-swatch__chip nameplate-swatch__chip--special-gold" aria-hidden="true"></span>
                  <span class="nameplate-swatch__text">Special Gold</span>
                </label>

                <label class="nameplate-swatch" for="np-color-textured-ivory-{{ section_id }}">
                  <input
                    id="np-color-textured-ivory-{{ section_id }}"
                    class="nameplate-swatch__radio"
                    type="radio"
                    name="properties[Choose Color]"
                    value="Textured Ivory"
                  >
                  <span class="nameplate-swatch__chip nameplate-swatch__chip--textured-ivory" aria-hidden="true"></span>
                  <span class="nameplate-swatch__text">Textured Ivory</span>
                </label>
              </div>
              <p class="nameplate-field__error" id="np-color-error-{{ section_id }}" hidden role="alert">
                Please choose a color.
              </p>
            </fieldset>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- comment %} Live Preview for font/text personalisation products {%- endcomment -%}
        {%- assign rg_has_font_option = false -%}
        {%- assign rg_font_option_index = 0 -%}
        {%- assign rg_text_option_index = -1 -%}
        {%- for rg_opt in product.options -%}
          {%- if rg_opt contains 'Font' or rg_opt contains 'font' -%}
            {%- assign rg_has_font_option = true -%}
            {%- assign rg_font_option_index = forloop.index0 -%}
          {%- endif -%}
          {%- if rg_opt contains 'Single Line' or rg_opt contains 'Text' or rg_opt contains 'Name' -%}
            {%- unless rg_opt contains 'Font' -%}
              {%- assign rg_text_option_index = forloop.index0 -%}
            {%- endunless -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if rg_has_font_option -%}
          {%- comment -%}
            Build the preview background URL.
            Priority 1: product.metafields.custom.preview_image  (file_reference metafield)
            Priority 2: product.featured_image
            Uses CSS background-image — NOT an <img> tag — so media-gallery.js
            never touches this element. Metafield must be checked with != blank
            because the namespace object is always truthy even when empty.
          {%- endcomment -%}
          {%- assign rg_preview_src = nil -%}
          {%- if product.metafields.custom.preview_image != blank -%}
            {%- assign rg_preview_src = product.metafields.custom.preview_image.value | image_url: width: 800 -%}
          {%- elsif product.featured_image != blank -%}
            {%- assign rg_preview_src = product.featured_image | image_url: width: 800 -%}
          {%- endif -%}

          {%- assign rg_initial_font = product.selected_or_first_available_variant.options[rg_font_option_index] -%}
          {%- assign rg_initial_text = '' -%}
          {%- if rg_text_option_index >= 0 -%}
            {%- assign rg_initial_text = product.selected_or_first_available_variant.options[rg_text_option_index] -%}
          {%- endif -%}

          <div class="rg-live-preview" id="RgLivePreview-{{ section_id }}">
            <p class="rg-live-preview__label">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
              Live Preview
            </p>
            <div
              class="rg-live-preview__stage"
              {% if rg_preview_src %}
                style="background-image: url('{{ rg_preview_src }}');"
              {% endif %}
            >
              <span class="rg-live-preview__text" id="RgPreviewText-{{ section_id }}">
                {{- rg_initial_text | default: 'YOUR TEXT' -}}
              </span>
            </div>
          </div>

          <style>
            #RgLivePreview-{{ section_id }} {
              margin: 14px 0 20px;
            }
            #RgLivePreview-{{ section_id }} .rg-live-preview__label {
              display: flex;
              align-items: center;
              gap: 5px;
              font-size: 10px;
              font-weight: 600;
              text-transform: uppercase;
              letter-spacing: 0.12em;
              color: rgba(255,255,255,0.45);
              margin: 0 0 8px;
            }
            #RgLivePreview-{{ section_id }} .rg-live-preview__stage {
              position: relative;
              width: 100%;
              height: 220px;
              border-radius: 8px;
              overflow: hidden;
              background-color: #141414;
              background-size: contain;
              background-repeat: no-repeat;
              background-position: center center;
              border: 1px solid rgba(255,255,255,0.08);
              display: flex;
              align-items: center;
              justify-content: center;
            }
            #RgLivePreview-{{ section_id }} .rg-live-preview__text {
              font-size: clamp(12px, 3.5vw, 28px);
              color: rgba(255, 255, 255, 0.95);
              text-shadow:
                0 0 16px rgba(0,0,0,0.9),
                0 1px 3px rgba(0,0,0,1);
              white-space: nowrap;
              max-width: 75%;
              overflow: hidden;
              text-overflow: ellipsis;
              letter-spacing: 0.04em;
              line-height: 1;
              pointer-events: none;
              transition: font-family 0.15s ease;
            }
          </style>

          <script>
          (function() {
            var sectionId = {{ section_id | json }};
            var productOptions = {{ product.options | json }};
            var assetUrl = {{ 'component-royalgifts.css' | asset_url | json }};
            var assetBase = assetUrl.substring(0, assetUrl.lastIndexOf('/') + 1);

            function init() {
              var previewEl = document.getElementById('RgPreviewText-' + sectionId);
              if (!previewEl) return;

              /* ── Text source ──────────────────────────────────────────
                 Priority 1: free-text line item property input
                 Priority 2: variant option value for "Text / Single Line / Name" option
              ─────────────────────────────────────────────────────────── */
              var textInput = document.querySelector(
                '[name="properties[Single Line Text]"], [name*="Single Line"], [name*="Engraving"]'
              );
              if (textInput) {
                textInput.addEventListener('input', function() {
                  previewEl.textContent = this.value.trim() || 'YOUR TEXT';
                });
                if (textInput.value.trim()) previewEl.textContent = textInput.value.trim();
              }

              /* ── Font source ──────────────────────────────────────────
                 Look for a <select> or radio fieldset whose label/legend
                 contains the word "Font".
              ─────────────────────────────────────────────────────────── */
              var variantRoot = document.getElementById('variant-selects-' + sectionId);

              function findFontSelect(root) {
                if (!root) return null;
                var selects = root.querySelectorAll('select');
                for (var i = 0; i < selects.length; i++) {
                  var w = selects[i].closest('.product-form__input');
                  var lbl = w && w.querySelector('.form__label');
                  if (lbl && lbl.textContent.indexOf('Font') !== -1) return { type: 'select', el: selects[i] };
                }
                var fieldsets = root.querySelectorAll('fieldset');
                for (var j = 0; j < fieldsets.length; j++) {
                  var leg = fieldsets[j].querySelector('legend');
                  if (leg && leg.textContent.indexOf('Font') !== -1) return { type: 'radio', el: fieldsets[j] };
                }
                return null;
              }

              var fontPicker = findFontSelect(variantRoot);

              function attachFontListener(picker) {
                if (!picker) return;
                if (picker.type === 'select') {
                  picker.el.addEventListener('change', function() { loadAndApplyFont(this.value, previewEl); });
                  loadAndApplyFont(picker.el.value, previewEl);
                } else {
                  var radios = picker.el.querySelectorAll('input[type="radio"]');
                  radios.forEach(function(r) {
                    r.addEventListener('change', function() {
                      if (this.checked) loadAndApplyFont(this.value, previewEl);
                    });
                  });
                  var checked = picker.el.querySelector('input[type="radio"]:checked');
                  if (checked) loadAndApplyFont(checked.value, previewEl);
                }
              }
              attachFontListener(fontPicker);

              /* ── Variant changed ─────────────────────────────────────────
                 Only update font and text — never touch the preview image.
                 Updating the image src here conflicts with media-gallery.js
                 which manages variant media independently. The preview image
                 is a static metafield/featured image set at render time.
              ─────────────────────────────────────────────────────────────── */
              document.addEventListener('variant:changed', function(e) {
                var variant = e.detail && e.detail.variant;
                if (!variant) return;

                productOptions.forEach(function(opt, i) {
                  if (opt.indexOf('Font') !== -1) {
                    var val = variant['option' + (i + 1)];
                    if (val) loadAndApplyFont(val, previewEl);
                  }
                  if (!textInput && opt.indexOf('Font') === -1
                      && (opt.indexOf('Single Line') !== -1 || opt.indexOf('Name') !== -1 || opt.indexOf('Text') !== -1)) {
                    var tv = variant['option' + (i + 1)];
                    if (tv) previewEl.textContent = tv;
                  }
                });
              });
            }

            /* ── Font loading via FontFace API ────────────────────────── */
            var loadedFonts = {};
            function loadAndApplyFont(fontName, el) {
              if (!fontName || !el) return;
              var cssName = fontName.replace(/\s+WOFF2?\s*$/i, '').trim();
              if (loadedFonts[cssName]) {
                el.style.fontFamily = '"' + cssName + '", serif';
                return;
              }
              var slug     = cssName.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9\-]/g, '');
              var urlWoff2 = assetBase + slug + '.woff2';
              var urlWoff  = assetBase + slug + '.woff';

              if (window.FontFace) {
                var face = new FontFace(
                  cssName,
                  'url("' + urlWoff2 + '") format("woff2"), url("' + urlWoff + '") format("woff")'
                );
                face.load().then(function(f) {
                  document.fonts.add(f);
                  loadedFonts[cssName] = true;
                  el.style.fontFamily = '"' + cssName + '", serif';
                }).catch(function() {
                  /* font file not found — still apply name so system may match */
                  el.style.fontFamily = '"' + cssName + '", serif';
                });
              } else {
                el.style.fontFamily = '"' + cssName + '", serif';
              }
            }

            if (document.readyState === 'loading') {
              document.addEventListener('DOMContentLoaded', init);
            } else {
              init();
            }
          })();
          </script>
        {%- endif -%}

        <div class="product-form__buttons">
          {%- liquid
            assign check_against_inventory = true
            if product.selected_or_first_available_variant.inventory_management != 'shopify' or product.selected_or_first_available_variant.inventory_policy == 'continue'
              assign check_against_inventory = false
            endif
            if product.selected_or_first_available_variant.quantity_rule.min > product.selected_or_first_available_variant.inventory_quantity and check_against_inventory
              assign quantity_rule_soldout = true
            endif
          -%}
          <button
            id="ProductSubmitButton-{{ section_id }}"
            type="submit"
            name="add"
            class="product-form__submit button button--full-width {% if show_dynamic_checkout %}button--secondary{% else %}button--primary{% endif %}"
            {% if product.selected_or_first_available_variant.available == false
              or quantity_rule_soldout
              or product.selected_or_first_available_variant == null
            %}
              disabled
            {% endif %}
          >
            <span>
              {%- if product.selected_or_first_available_variant == null -%}
                {{ 'products.product.unavailable' | t }}
              {%- elsif product.selected_or_first_available_variant.available == false or quantity_rule_soldout -%}
                {{ 'products.product.sold_out' | t }}
              {%- else -%}
                {{ 'products.product.add_to_cart' | t }}
              {%- endif -%}
            </span>
            {%- render 'loading-spinner' -%}
          </button>
          {%- if show_dynamic_checkout -%}
            {{ form | payment_button }}
          {%- endif -%}
        </div>
      {%- endform -%}
    </product-form>
  {%- else -%}
    <div class="product-form">
      <div class="product-form__buttons form">
        <button
          type="submit"
          name="add"
          class="product-form__submit button button--full-width button--primary"
          disabled
        >
          {{ 'products.product.sold_out' | t }}
        </button>
      </div>
    </div>
  {%- endif -%}

  {%- if show_pickup_availability -%}
    {{ 'component-pickup-availability.css' | asset_url | stylesheet_tag }}

    {%- assign pick_up_availabilities = product.selected_or_first_available_variant.store_availabilities
      | where: 'pick_up_enabled', true
    -%}

    <pickup-availability
      class="product__pickup-availabilities quick-add-hidden"
      {% if product.selected_or_first_available_variant.available and pick_up_availabilities.size > 0 %}
        available
      {% endif %}
      data-root-url="{{ routes.root_url }}"
      data-variant-id="{{ product.selected_or_first_available_variant.id }}"
      data-has-only-default-variant="{{ product.has_only_default_variant }}"
      data-product-page-color-scheme="gradient color-{{ section.settings.color_scheme }}"
    >
      <template>
        <pickup-availability-preview class="pickup-availability-preview">
          <span class="svg-wrapper">
            {{- 'icon-unavailable.svg' | inline_asset_content -}}
          </span>
          <div class="pickup-availability-info">
            <p class="caption-large">{{ 'products.product.pickup_availability.unavailable' | t }}</p>
            <button class="pickup-availability-button link link--text underlined-link">
              {{ 'products.product.pickup_availability.refresh' | t }}
            </button>
          </div>
        </pickup-availability-preview>
      </template>
    </pickup-availability>

    <script src="{{ 'pickup-availability.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}
</div>
