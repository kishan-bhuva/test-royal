{{ 'luxury-theme.css' | asset_url | stylesheet_tag }}

{%- style -%}
  /* Section spacing only. Visual system is controlled by luxury-theme.css */
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .lux-home-section--cta .dn-final-cta__inner {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 2.8rem 2rem;
      border-radius: 1.6rem;
    }

    .lux-home-section--cta .dn-final-cta__heading {
      font-size: 2.2rem;
      line-height: 1.2;
      text-align: center;
    }

    .lux-home-section--cta .dn-final-cta__button {
      width: auto !important;
      min-width: 0 !important;
      max-width: 100%;
      margin: 1.8rem auto 0 !important;
      padding: 1.2rem 2rem !important;
      font-size: 1.3rem !important;
      min-height: 4.8rem !important;
    }
  }
{%- endstyle -%}

<section class="dn-final-cta dn-final-cta--{{ section.id }} lux-home-section lux-home-section--cta section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="dn-final-cta__inner" data-lux-reveal>
      <h2 class="dn-final-cta__heading">
        {{ section.settings.heading }}
      </h2>
      {%- if section.settings.button_link != blank -%}
        <a href="{{ section.settings.button_link }}" class="button button--primary dn-final-cta__button">
          {{ section.settings.button_label }}
        </a>
      {%- else -%}
        <a href="{{ routes.all_products_collection_url }}" class="button button--primary dn-final-cta__button">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom Final CTA",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Upgrade Your Entrance Today"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Design Your Nameplate"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Custom Final CTA"
    }
  ]
}
{% endschema %}
