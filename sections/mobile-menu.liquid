<style>
  .mobile-menu-section {
    display: none;
  }

  @media screen and (max-width: 989px) {
    .mobile-menu-section {
      display: block;
    }

    .footer-mobile {
      display: flex;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 300;
      background: #0d0d0d;
      border-top: 1px solid rgba(198, 161, 58, 0.15);
      padding: 0 0 env(safe-area-inset-bottom, 0px);
    }

    .footer-mobile .header__icon,
    .footer-mobile .header__search {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    .footer-mobile a,
    .footer-mobile summary {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 4px;
      padding: 10px 4px 8px;
      text-decoration: none;
      color: rgba(245, 244, 239, 0.5);
      font-family: 'Inter', sans-serif;
      font-size: 10px;
      font-weight: 500;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      transition: color 0.2s ease;
      width: 100%;
      cursor: pointer;
      list-style: none;
    }

    .footer-mobile a,
    .footer-mobile summary {
      position: relative;
    }

    .footer-mobile a svg,
    .footer-mobile summary svg {
      width: 22px;
      height: 22px;
      flex-shrink: 0;
    }

    /* hide sprite SVGs that may not render */
    .footer-mobile .modal__toggle-close,
    .footer-mobile .icon-close,
    .footer-mobile .icon-reset {
      display: none;
    }

    .mob-menu-bar__badge {
      position: absolute;
      top: 6px;
      left: 50%;
      margin-left: 4px;
      min-width: 16px;
      height: 16px !important;
      padding: 0 4px;
      background: #C6A13A;
      color: #0b0b0b;
      font-size: 9px;
      font-weight: 700;
      line-height: 16px;
      text-align: center;
      border-radius: 999px;
    }

    .footer-mobile a:hover,
    .footer-mobile summary:hover,
    .footer-mobile a.active {
      color: #C6A13A;
    }

    .footer-mobile a:hover svg,
    .footer-mobile summary:hover svg {
      stroke: #C6A13A;
    }

    .footer-mobile .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .footer-mobile .search-modal {
      position: fixed;
      inset: 0;
      z-index: 400;
      background: rgba(0, 0, 0, 0.9);
      display: flex;
      align-items: flex-start;
      justify-content: center;
      padding-top: 80px;
    }

    .footer-mobile .search-modal__content {
      width: 100%;
      max-width: 500px;
      padding: 0 20px;
    }

    .footer-mobile .search-modal__form .field {
      display: flex;
      align-items: center;
      background: #1a1a1a;
      border: 1px solid rgba(198, 161, 58, 0.3);
      border-radius: 8px;
      overflow: hidden;
    }

    .footer-mobile .search__input {
      flex: 1;
      padding: 14px 16px;
      background: transparent;
      border: none;
      color: #f5f4ef;
      font-size: 15px;
      outline: none;
    }

    .footer-mobile .search__input::placeholder {
      color: rgba(245, 244, 239, 0.4);
    }

    .footer-mobile .modal__close-button {
      padding: 14px 16px;
      background: none;
      border: none;
      color: rgba(245, 244, 239, 0.5);
      cursor: pointer;
    }

    body {
      padding-bottom: calc(60px + env(safe-area-inset-bottom, 0px));
    }
  }
</style>

{% if section.settings.show_mobile_menu %}
  <div
    class="menu-block"
    data-section-id="{{ section.id }}"
    data-section-type="menu-section"
  >
    <div class="footer-mobile">

      {% if section.settings.show_mobile_home %}
        <div class="header__icon site-header__icon">
          <a href="{{ routes.root_url }}" aria-label="Home" {% if request.page_type == 'index' %}class="active"{% endif %}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5Z"/>
              <path d="M9 21V12h6v9"/>
            </svg>
            Home
          </a>
        </div>
      {% endif %}

      {% if section.settings.show_mobile_account %}
        <div class="header__icon site-header__icon">
          <a href="https://wa.me/917742377328?text=Hi%2C%20I%20saw%20your%20products%20and%20I%27m%20interested.%20Can%20you%20share%20more%20details%3F"
             aria-label="WhatsApp"
             target="_blank"
             rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" fill="#25D366" stroke="none" aria-hidden="true">
              <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2zm0 18.16c-1.49 0-2.95-.4-4.23-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.26 8.26 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c.02 4.54-3.68 8.23-8.19 8.23zm4.52-6.17c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.13-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07s.89 2.4 1.01 2.56c.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.11-.22-.17-.47-.29z"/>
            </svg>
            WhatsApp
          </a>
        </div>
      {% endif %}

      {% if section.settings.show_mobile_collections %}
        <div class="header__icon site-header__icon">
          <a href="{{ routes.all_products_collection_url }}" aria-label="Collections"
             {% if request.page_type == 'list-collections' %}class="active"{% endif %}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="7" height="7" rx="1"/>
              <rect x="14" y="3" width="7" height="7" rx="1"/>
              <rect x="3" y="14" width="7" height="7" rx="1"/>
              <rect x="14" y="14" width="7" height="7" rx="1"/>
            </svg>
            Shop
          </a>
        </div>
      {% endif %}

      {% if section.settings.show_mobile_wishlist %}
        <div class="header__icon site-header__icon">
          <a href="{{ section.settings.mobile_wishlist_link | default: '/pages/wishlist' }}" aria-label="Wishlist">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
            Wishlist
          </a>
        </div>
      {% endif %}

      {% if section.settings.show_mobile_search %}
        <div class="header__icon site-header__icon">
          <a href="{{ routes.search_url }}" aria-label="{{ 'general.search.search' | t }}"
             {% if request.page_type == 'search' %}class="active"{% endif %}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7"/>
              <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            Search
          </a>
        </div>
      {% endif %}

      {% if section.settings.show_mobile_cart %}
        <a
          href="{{ routes.cart_url }}"
          class="header__icon header__icon--cart link focus-inset{% if request.page_type == 'cart' %} active{% endif %}"
          aria-label="{{ 'templates.cart.cart' | t }}"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
            <line x1="3" y1="6" x2="21" y2="6"/>
            <path d="M16 10a4 4 0 0 1-8 0"/>
          </svg>
          {%- if cart.item_count > 0 -%}
            <span class="mob-menu-bar__badge" aria-hidden="true">
              {%- if cart.item_count < 10 -%}{{ cart.item_count }}{%- else -%}9+{%- endif -%}
            </span>
          {%- endif -%}
          Cart
          <span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
        </a>
      {% endif %}

    </div>
  </div>
{% endif %}

{%- if settings.cart_type == 'notification' -%}
  {%- render 'cart-notification',
    color_scheme: section.settings.color_scheme,
    desktop_menu_type: section.settings.menu_type_desktop
  -%}
{%- endif -%}

{% schema %}
{
  "name": "Mobile Menu Bar",
  "tag": "section",
  "class": "mobile-menu-section section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_mobile_menu",
      "default": true,
      "label": "Show mobile bottom menu"
    },
    {
      "type": "checkbox",
      "id": "show_mobile_home",
      "default": true,
      "label": "Show Home"
    },
    {
      "type": "checkbox",
      "id": "show_mobile_account",
      "default": true,
      "label": "Show Account"
    },
    {
      "type": "checkbox",
      "id": "show_mobile_collections",
      "default": true,
      "label": "Show Collections"
    },
    {
      "type": "checkbox",
      "id": "show_mobile_wishlist",
      "default": false,
      "label": "Show Wishlist"
    },
    {
      "type": "url",
      "id": "mobile_wishlist_link",
      "label": "Wishlist link"
    },
    {
      "type": "checkbox",
      "id": "show_mobile_search",
      "default": true,
      "label": "Show Search"
    },
    {
      "type": "checkbox",
      "id": "show_mobile_cart",
      "default": true,
      "label": "Show Cart"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        { "value": "accent-1", "label": "Accent 1" },
        { "value": "accent-2", "label": "Accent 2" },
        { "value": "background-1", "label": "Background 1" },
        { "value": "background-2", "label": "Background 2" },
        { "value": "inverse", "label": "Inverse" }
      ],
      "default": "background-2",
      "label": "Color scheme"
    }
  ],
  "presets": [
    {
      "name": "Mobile Menu Bar"
    }
  ]
}
{% endschema %}
