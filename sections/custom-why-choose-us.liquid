{{ 'luxury-theme.css' | asset_url | stylesheet_tag }}

{%- style -%}
  /* Section spacing only. Visual system is controlled by luxury-theme.css */
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="dn-why-choose dn-why-choose--{{ section.id }} lux-home-section lux-home-section--benefits section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <header class="dn-why-choose__header" data-lux-reveal>
        {%- if section.settings.heading != blank -%}
          <h2 class="dn-why-choose__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="dn-why-choose__subtitle">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    <div class="dn-why-choose__grid" role="list">
      {%- for block in section.blocks limit: 4 -%}
        <article class="dn-why-choose__item" role="listitem" data-lux-reveal {{ block.shopify_attributes }}>
          <div class="dn-why-choose__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'craft' -%}
                <svg viewBox="0 0 24 24">
                  <path d="m15 12-8.5 8.5a2.12 2.12 0 0 1-3 0 2.12 2.12 0 0 1 0-3L12 9"></path>
                  <path d="m17.64 15 4.36-4.36"></path>
                  <path d="m20.91 11.7-1.25-1.25a3.2 3.2 0 0 1-.93-2.25v-.86L16.01 4.6a5.56 5.56 0 0 0-3.94-1.64H9"></path>
                </svg>
              {%- when 'quality' -%}
                <svg viewBox="0 0 24 24">
                  <path d="M12 2 4 5v6c0 5 3.4 9.6 8 11 4.6-1.4 8-6 8-11V5l-8-3Z"></path>
                  <path d="m9 12 2 2 4-4"></path>
                </svg>
              {%- when 'design' -%}
                <svg viewBox="0 0 24 24">
                  <path d="M12 20h9"></path>
                  <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5Z"></path>
                </svg>
              {%- when 'delivery' -%}
                <svg viewBox="0 0 24 24">
                  <path d="M1 3h15v13H1z"></path>
                  <path d="M16 8h4l3 3v5h-7z"></path>
                  <circle cx="5.5" cy="18.5" r="2.5"></circle>
                  <circle cx="18.5" cy="18.5" r="2.5"></circle>
                </svg>
              {%- else -%}
                <svg viewBox="0 0 24 24">
                  <circle cx="12" cy="12" r="9"></circle>
                  <path d="m9 12 2 2 4-4"></path>
                </svg>
            {%- endcase -%}
          </div>
          {%- if block.settings.title != blank -%}
            <h3 class="dn-why-choose__item-title">{{ block.settings.title }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="dn-why-choose__item-text">{{ block.settings.text }}</p>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom Why Choose Us",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Why Choose Us"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Precision craft, premium materials, and delivery you can trust."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 68
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 68
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Icon box",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "craft",
          "options": [
            {
              "value": "craft",
              "label": "Craft"
            },
            {
              "value": "quality",
              "label": "Quality"
            },
            {
              "value": "design",
              "label": "Design"
            },
            {
              "value": "delivery",
              "label": "Delivery"
            }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Premium Materials"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Engineered for durability with premium-grade finishes."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Why Choose Us",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "icon": "craft",
            "title": "Handcrafted Detailing",
            "text": "Every order is finished by skilled artisans."
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "quality",
            "title": "Built to Last",
            "text": "Weather-resistant materials and premium coatings."
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "design",
            "title": "Personalized Design",
            "text": "Tailored typography and layout for your entrance."
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "delivery",
            "title": "Reliable Delivery",
            "text": "Secure packaging and on-time doorstep shipping."
          }
        }
      ]
    }
  ]
}
{% endschema %}
