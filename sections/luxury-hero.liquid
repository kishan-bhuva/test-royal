    },
    {
      "type": "image_picker",
      "id": "hero_image_3",
      "label": "Image 3"
    },
    {
      "type": "image_picker",
      "id": "hero_image_4",
      "label": "Image 4"
    },
    {
      "type": "header",
      "content": "Image Labels"
    },
    {
      "type": "text",
      "id": "float_label",
