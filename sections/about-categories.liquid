{{ 'about-luxury.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="rg-about-section rg-about-categories section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="rg-about-header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="rg-about-kicker">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      <h2 class="rg-about-heading">{{ section.settings.heading | escape }}</h2>

      {%- if section.settings.text != blank -%}
        <div class="rg-about-copy rte">
          {{ section.settings.text }}
        </div>
      {%- endif -%}
    </div>

    <div class="rg-about-categories__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign category_image_alt = block.settings.title
          if block.settings.image != blank and block.settings.image.alt != blank
            assign category_image_alt = block.settings.image.alt
          endif
        -%}
        <div class="rg-about-card rg-about-category" {{ block.shopify_attributes }}>
          <div class="rg-about-category__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 900
                | image_tag: class: 'rg-about-category__image', loading: 'lazy', alt: category_image_alt
              }}
            {%- else -%}
              <div class="rg-about-media-placeholder rg-about-category__placeholder">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
                  <rect x="3" y="4" width="18" height="16" rx="2"></rect>
                  <path d="M7 15l3-3 3 3 4-5 3 4"></path>
                </svg>
              </div>
            {%- endif -%}
          </div>

          <div class="rg-about-category__body">
            <h3 class="rg-about-category__title">{{ block.settings.title | escape }}</h3>
            <p class="rg-about-category__text">{{ block.settings.text | escape }}</p>

            {%- if block.settings.link != blank and block.settings.link_label != blank -%}
              <a href="{{ block.settings.link }}" class="rg-about-category__link">
                {{ block.settings.link_label | escape }}
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About - Categories",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Collections"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Product Categories"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Intro text",
      "default": "<p>Explore the signature categories that define Royal Gifts and our personalized design approach.</p>"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Door Name Plates"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Elegant personalized plates designed to create a memorable first impression."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Explore"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About - Categories",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "Door Name Plates",
            "text": "Elegant personalized plates designed to create a memorable first impression.",
            "link_label": "Explore"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Corporate Gifts",
            "text": "Thoughtful branded and personalized gifting ideas for teams, clients, and events.",
            "link_label": "Explore"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Metal Wall Decor",
            "text": "Statement pieces crafted to add depth, character, and luxury to modern interiors.",
            "link_label": "Explore"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Custom Acrylic Designs",
            "text": "Clean, contemporary acrylic creations tailored to names, moments, and spaces.",
            "link_label": "Explore"
          }
        }
      ]
    }
  ]
}
{% endschema %}
