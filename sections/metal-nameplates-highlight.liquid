<section
  class="mnh-section-{{ section.id }}"
  {% if section.settings.image != blank %}
    style="background-image: url('{{ section.settings.image | image_url: width: 1600 }}');"
  {% endif %}
>
  <div class="mnh-overlay"></div>
  <div class="mnh-container">
    <div class="mnh-content">
      {% if section.settings.subheading != blank %}
        <p class="mnh-subheading">{{ section.settings.subheading }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="mnh-heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <p class="mnh-description">{{ section.settings.description }}</p>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link }}" class="mnh-button">
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .mnh-section-{{ section.id }} {
    position: relative;
    background-color: #0f0f0f;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    padding: 120px 40px;
  }

  .mnh-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(0,0,0,0.82) 40%, rgba(0,0,0,0.35) 100%);
    z-index: 1;
  }

  .mnh-container {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    margin: 0 auto;
  }

  .mnh-content {
    max-width: 520px;
  }

  .mnh-subheading {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #D4AF37;
    margin: 0 0 16px;
  }

  .mnh-heading {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    line-height: 1.15;
    color: #f5f0e8;
    margin: 0 0 24px;
    letter-spacing: -0.01em;
  }

  .mnh-description {
    font-size: 1rem;
    line-height: 1.75;
    color: #c8b99a;
    margin: 0 0 36px;
  }

  .mnh-button {
    display: inline-block;
    padding: 14px 32px;
    background-color: #D4AF37;
    color: #0f0f0f;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 3px;
    transition: background-color 0.25s ease;
  }

  .mnh-button:hover {
    background-color: #f0cc60;
  }

  @media screen and (max-width: 768px) {
    .mnh-section-{{ section.id }} {
      padding: 80px 20px;
    }

    .mnh-overlay {
      background: rgba(0, 0, 0, 0.72);
    }

    .mnh-content {
      max-width: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "Metal Nameplates",
  "tag": "section",
  "class": "metal-nameplates-highlight",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Premium Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Metal Nameplates"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Crafted from high-grade metals with precision engraving, our nameplates combine timeless elegance with lasting durability — perfect for homes, offices, and gifting."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Metal Nameplates"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Section image"
    }
  ],
  "presets": [
    {
      "name": "Metal Nameplates Highlight"
    }
  ]
}
{% endschema %}
