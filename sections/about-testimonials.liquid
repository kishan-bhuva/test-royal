{{ 'about-luxury.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="rg-about-section rg-about-testimonials section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="rg-about-header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="rg-about-kicker">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      <h2 class="rg-about-heading">{{ section.settings.heading | escape }}</h2>

      {%- if section.settings.text != blank -%}
        <div class="rg-about-copy rte">
          {{ section.settings.text }}
        </div>
      {%- endif -%}
    </div>

    <div class="rg-about-testimonials__grid">
      {%- for block in section.blocks -%}
        <div class="rg-about-card rg-about-testimonial" {{ block.shopify_attributes }}>
          <div class="rg-about-stars" role="img" aria-label="{{ block.settings.rating }} out of 5 stars">
            {%- for i in (1..5) -%}
              <span>
                {%- if i <= block.settings.rating -%}
                  &#9733;
                {%- else -%}
                  &#9734;
                {%- endif -%}
              </span>
            {%- endfor -%}
          </div>

          <p class="rg-about-testimonial__quote">{{ block.settings.quote | escape }}</p>

          <div class="rg-about-testimonial__meta">
            {{ block.settings.author | escape }}
            {%- if block.settings.location != blank -%}
              | {{ block.settings.location | escape }}
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About - Testimonials",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Customer Trust"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trusted by Customers"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Intro text",
      "default": "<p>Real feedback from customers who chose Royal Gifts for their homes and heartfelt gifting moments.</p>"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Beautiful craftsmanship and premium quality nameplate."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Royal Gifts Customer"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location",
          "default": "India"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About - Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "quote": "Beautiful craftsmanship and premium quality nameplate.",
            "author": "Aarav Mehta",
            "location": "Ahmedabad"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "quote": "Perfect personalized gift for our new home.",
            "author": "Neha Kapoor",
            "location": "Pune"
          }
        }
      ]
    }
  ]
}
{% endschema %}
