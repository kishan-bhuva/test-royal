{%- liquid
  assign show_date_metafield = blank
  assign timeline_enabled_in_theme = section.settings.show_timeline
  assign timeline_visible = false
  assign processing_days_value = section.settings.processing_days
  assign processing_metafield = blank
  assign processing_end_date_value = blank
  assign processing_raw_value = blank

  if product
    assign show_date_metafield = product.metafields.custom.show_date_field

    if show_date_metafield == blank
      assign show_date_metafield = product.metafields.custom.show_date
    endif

    if timeline_enabled_in_theme and show_date_metafield != blank
      assign timeline_visible = show_date_metafield.value | default: false, allow_false: true
    endif

    assign processing_metafield = product.metafields.custom.processing_end_date_field

    if processing_metafield == blank
      assign processing_metafield = product.metafields.custom.processing_end_date
    endif

    if processing_metafield == blank
      assign processing_metafield = product.metafields.custom.processing_days
    endif

    if processing_metafield != blank
      assign processing_raw_value = processing_metafield.value

      if processing_metafield.type contains 'date'
        assign processing_end_date_value = processing_raw_value | date: '%Y-%m-%d'
      else
        assign processing_days_value = processing_raw_value | default: section.settings.processing_days
      endif
    endif
  endif
-%}

{%- if product and timeline_visible -%}
  <style>
    .delivery-timeline--{{ section.id }} {
      --timeline-surface:
        radial-gradient(circle at top right, rgba(212, 175, 55, 0.14) 0%, rgba(212, 175, 55, 0) 26%),
        radial-gradient(circle at bottom left, rgba(18, 61, 43, 0.3) 0%, rgba(18, 61, 43, 0) 34%),
        linear-gradient(145deg, #102019 0%, #0a1510 52%, #060907 100%);
      --timeline-border: rgba(212, 175, 55, 0.18);
      --timeline-shadow: 0 28px 58px rgba(0, 0, 0, 0.34);
      --timeline-text: #f4efe3;
      --timeline-subtle: rgba(223, 230, 222, 0.74);
      --timeline-accent: #d4af37;
      --timeline-accent-dark: #efd27a;
      --timeline-track: rgba(212, 175, 55, 0.14);
      --timeline-track-fill: linear-gradient(90deg, #7a5919 0%, #d4af37 38%, #f2dc9c 55%, #b98525 100%);
      --timeline-card: linear-gradient(180deg, rgba(15, 28, 21, 0.95) 0%, rgba(9, 18, 14, 0.98) 100%);
      --timeline-card-alt: linear-gradient(180deg, rgba(18, 34, 25, 0.95) 0%, rgba(10, 19, 15, 0.98) 100%);
      margin: 28px 0;
    }

    .delivery-timeline--{{ section.id }} .delivery-timeline__shell {
      position: relative;
      overflow: hidden;
      padding: 24px;
      border: 1px solid var(--timeline-border);
      border-radius: 24px;
      background: var(--timeline-surface);
      box-shadow: var(--timeline-shadow);
      isolation: isolate;
      backdrop-filter: blur(10px);
    }

    .delivery-timeline--{{ section.id }} .delivery-timeline__shell::before,
    .delivery-timeline--{{ section.id }} .delivery-timeline__shell::after {
      content: '';
      position: absolute;
      border-radius: 999px;
      pointer-events: none;
      z-index: -1;
    }

    .delivery-timeline--{{ section.id }} .delivery-timeline__shell::before {
      top: -62px;
      right: -24px;
      width: 180px;
      height: 180px;
      background: radial-gradient(circle, rgba(212, 175, 55, 0.2) 0%, rgba(212, 175, 55, 0) 72%);
      animation: deliveryTimelineFloat-{{ section.id }} 7s ease-in-out infinite;
    }

    .delivery-timeline--{{ section.id }} .delivery-timeline__shell::after {
      bottom: -76px;
      left: -28px;
      width: 220px;
      height: 220px;
      background: radial-gradient(circle, rgba(18, 61, 43, 0.24) 0%, rgba(18, 61, 43, 0) 70%);
    }

    .delivery-timeline--{{ section.id }} .delivery-timeline__header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 18px;
      margin-bottom: 22px;
    }

    .delivery-timeline--{{ section.id }} .delivery-timeline__eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin: 0 0 10px;
      padding: 7px 12px;
      border-radius: 999px;
      background: rgba(212, 175, 55, 0.09);
      border: 1px solid rgba(212, 175, 55, 0.14);
      color: var(--timeline-accent);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .delivery-timeline--{{ section.id }} .delivery-timeline__eyebrow-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--timeline-accent);
      box-shadow: 0 0 0 6px rgba(212, 175, 55, 0.12);
      animation: deliveryTimelinePulse-{{ section.id }} 2.1s ease-in-out infinite;
    }

    .delivery-timeline--{{ section.id }} .delivery-timeline__title {
      margin: 0;
      font-family: 'Playfair Display', Georgia, serif;
      font-size: clamp(22px, 2.8vw, 30px);
      line-height: 1.15;
      color: var(--timeline-text);
    }

    .delivery-timeline--{{ section.id }} .delivery-timeline__subtitle {
      margin: 8px 0 0;
      max-width: 650px;
      color: var(--timeline-subtle);
      font-size: 14px;
      line-height: 1.6;
    }

    .delivery-timeline--{{ section.id }} .delivery-timeline__summary {
      min-width: 180px;
      padding: 14px 16px;
      border-radius: 18px;
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.02) 100%);
      border: 1px solid rgba(212, 175, 55, 0.14);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
      text-align: right;
    }

    .delivery-timeline--{{ section.id }} .delivery-timeline__summary-label {
      display: block;
      margin-bottom: 4px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgba(212, 175, 55, 0.72);
    }

    .delivery-timeline--{{ section.id }} .delivery-timeline__summary-value {
      display: block;
      color: var(--timeline-text);
      font-size: 18px;
      font-weight: 700;
      line-height: 1.3;
    }

    .delivery-timeline--{{ section.id }} .delivery-timeline__progress {
      position: relative;
      margin-bottom: 26px;
      padding: 0 11%;
    }

    .delivery-timeline--{{ section.id }} .delivery-timeline__progress-track,
    .delivery-timeline--{{ section.id }} .delivery-timeline__progress-fill {
      height: 8px;
      border-radius: 999px;
    }

    .delivery-timeline--{{ section.id }} .delivery-timeline__progress-track {
      background: var(--timeline-track);
    }

    .delivery-timeline--{{ section.id }} .delivery-timeline__progress-fill {
      position: absolute;
      top: 0;
      left: 11%;
      width: 78%;
      background: var(--timeline-track-fill);
      box-shadow: 0 6px 18px rgba(183, 132, 46, 0.28);
      overflow: hidden;
    }

    .delivery-timeline--{{ section.id }} .delivery-timeline__progress-fill::after {
      content: '';
      position: absolute;
      inset: 0;
      transform: translateX(-100%);
      background: linear-gradient(90deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.38) 48%, rgba(255, 255, 255, 0) 100%);
      animation: deliveryTimelineShine-{{ section.id }} 3.1s ease-in-out infinite;
    }

    .delivery-timeline--{{ section.id }} .delivery-timeline__steps {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
      align-items: stretch;
    }

    .delivery-timeline--{{ section.id }} .delivery-timeline__step {
      position: relative;
      overflow: hidden;
      padding: 18px 18px 16px;
      border-radius: 20px;
      background: var(--timeline-card);
      border: 1px solid rgba(212, 175, 55, 0.12);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03), 0 14px 30px rgba(0, 0, 0, 0.22);
      backdrop-filter: blur(8px);
      transition: transform 0.28s ease, box-shadow 0.28s ease, border-color 0.28s ease;
    }

    .delivery-timeline--{{ section.id }} .delivery-timeline__step::before {
      content: '';
      position: absolute;
      inset: 0 0 auto 0;
      height: 1px;
      background: linear-gradient(90deg, rgba(212, 175, 55, 0.34) 0%, rgba(212, 175, 55, 0) 100%);
    }

    .delivery-timeline--{{ section.id }} .delivery-timeline__step:hover {
      transform: translateY(-4px);
      border-color: rgba(212, 175, 55, 0.28);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03), 0 18px 34px rgba(0, 0, 0, 0.28);
    }

    .delivery-timeline--{{ section.id }} .delivery-timeline__step--processing {
      background: var(--timeline-card-alt);
    }

    .delivery-timeline--{{ section.id }} .delivery-timeline__step--delivery {
      background: linear-gradient(180deg, rgba(17, 31, 23, 0.95) 0%, rgba(8, 16, 12, 0.98) 100%);
    }

    .delivery-timeline--{{ section.id }} .delivery-timeline__icon-wrap {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 56px;
      height: 56px;
      margin-bottom: 14px;
      border-radius: 18px;
      border: 1px solid rgba(212, 175, 55, 0.2);
      background: linear-gradient(145deg, rgba(212, 175, 55, 0.18) 0%, rgba(20, 39, 29, 0.94) 55%, rgba(8, 14, 11, 0.98) 100%);
      color: var(--timeline-accent);
      box-shadow: 0 14px 30px rgba(0, 0, 0, 0.28), inset 0 1px 0 rgba(255, 255, 255, 0.08);
      isolation: isolate;
    }

    .delivery-timeline--{{ section.id }} .delivery-timeline__icon-wrap::after {
      content: '';
      position: absolute;
      inset: 10px;
      border-radius: 14px;
      background: radial-gradient(circle at 30% 30%, rgba(212, 175, 55, 0.24) 0%, rgba(212, 175, 55, 0) 74%);
      z-index: -1;
    }

    .delivery-timeline--{{ section.id }} .delivery-timeline__step--delivery .delivery-timeline__icon-wrap {
      background: linear-gradient(145deg, rgba(212, 175, 55, 0.2) 0%, rgba(18, 37, 28, 0.95) 55%, rgba(7, 14, 11, 0.98) 100%);
    }

    .delivery-timeline--{{ section.id }} .delivery-timeline__icon {
      width: 26px;
      height: 26px;
      display: block;
      position: relative;
      z-index: 1;
    }

    .delivery-timeline--{{ section.id }} .delivery-timeline__label {
      margin: 0 0 4px;
      color: var(--timeline-accent);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .delivery-timeline--{{ section.id }} .delivery-timeline__date {
      margin: 0;
      color: var(--timeline-text);
      font-size: clamp(18px, 2vw, 21px);
      font-weight: 700;
      line-height: 1.35;
    }

    .delivery-timeline--{{ section.id }} .delivery-timeline__hint {
      margin: 8px 0 0;
      color: var(--timeline-subtle);
      font-size: 13px;
      line-height: 1.45;
    }

    @media screen and (max-width: 989px) {
      .delivery-timeline--{{ section.id }} .delivery-timeline__header {
        flex-direction: column;
      }

      .delivery-timeline--{{ section.id }} .delivery-timeline__summary {
        width: 100%;
        text-align: left;
      }
    }

    @media screen and (max-width: 749px) {
      .delivery-timeline--{{ section.id }} .delivery-timeline__shell {
        padding: 20px 16px;
        border-radius: 22px;
      }

      .delivery-timeline--{{ section.id }} .delivery-timeline__progress {
        display: none;
      }

      .delivery-timeline--{{ section.id }} .delivery-timeline__steps {
        grid-template-columns: 1fr;
        gap: 14px;
      }

      .delivery-timeline--{{ section.id }} .delivery-timeline__step {
        padding: 16px;
      }

      .delivery-timeline--{{ section.id }} .delivery-timeline__icon-wrap {
        width: 50px;
        height: 50px;
        border-radius: 16px;
      }
    }

    @keyframes deliveryTimelinePulse-{{ section.id }} {
      0%,
      100% {
        transform: scale(1);
        box-shadow: 0 0 0 0 rgba(199, 154, 62, 0.2);
      }

      50% {
        transform: scale(1.06);
        box-shadow: 0 0 0 8px rgba(199, 154, 62, 0);
      }
    }

    @keyframes deliveryTimelineShine-{{ section.id }} {
      0% {
        transform: translateX(-100%);
      }

      55%,
      100% {
        transform: translateX(140%);
      }
    }

    @keyframes deliveryTimelineFloat-{{ section.id }} {
      0%,
      100% {
        transform: translate3d(0, 0, 0);
      }

      50% {
        transform: translate3d(-10px, 10px, 0);
      }
    }
  </style>

  <section
    id="DeliveryTimeline-{{ section.id }}"
    class="delivery-timeline delivery-timeline--{{ section.id }}"
    data-delivery-timeline
    data-processing-days="{{ processing_days_value | escape }}"
    data-processing-fallback="{{ section.settings.processing_days | escape }}"
    data-processing-raw="{{ processing_raw_value | escape }}"
    data-processing-end-date="{{ processing_end_date_value | escape }}"
    data-delivery-days="{{ section.settings.delivery_duration | escape }}"
    aria-label="Delivery timeline"
  >
    <div class="page-width">
      <div class="delivery-timeline__shell">
        <div class="delivery-timeline__header">
          <div class="delivery-timeline__content">
            <p class="delivery-timeline__eyebrow">
              <span class="delivery-timeline__eyebrow-dot" aria-hidden="true"></span>
              Delivery timeline
            </p>
            <h2 class="delivery-timeline__title">Track the journey of your order</h2>
            <p class="delivery-timeline__subtitle">From order confirmation to doorstep delivery, your estimated dates are shown below for this product.</p>
          </div>
          <div class="delivery-timeline__summary">
            <span class="delivery-timeline__summary-label">Estimated window</span>
            <span id="delivery-range-{{ section.id }}" class="delivery-timeline__summary-value" aria-live="polite"></span>
          </div>
        </div>

        <div class="delivery-timeline__progress" aria-hidden="true">
          <div class="delivery-timeline__progress-track"></div>
          <div class="delivery-timeline__progress-fill"></div>
        </div>

        <div class="delivery-timeline__steps" role="list">
          <article class="delivery-timeline__step delivery-timeline__step--ordered" role="listitem">
            <span class="delivery-timeline__icon-wrap" aria-hidden="true">
              <svg class="delivery-timeline__icon" viewBox="0 0 24 24" fill="none">
                <path d="M9.75 3.5h4.5A1.25 1.25 0 0 1 15.5 4.75V6h1.25a1.75 1.75 0 0 1 1.75 1.75v10.5A1.75 1.75 0 0 1 16.75 20H7.25A1.75 1.75 0 0 1 5.5 18.25V7.75A1.75 1.75 0 0 1 7.25 6H8.5V4.75A1.25 1.25 0 0 1 9.75 3.5Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M9.5 6h5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                <path d="m9.4 12.15 1.75 1.75 3.45-3.65" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <p class="delivery-timeline__label">Ordered</p>
            <p id="ordered-date" class="delivery-timeline__date" aria-live="polite"></p>
            <p class="delivery-timeline__hint">Your order is received and added to the production queue.</p>
          </article>

          <article class="delivery-timeline__step delivery-timeline__step--processing" role="listitem">
            <span class="delivery-timeline__icon-wrap" aria-hidden="true">
              <svg class="delivery-timeline__icon" viewBox="0 0 24 24" fill="none">
                <path d="M12 4.25 13.76 7.6l3.74.54-2.7 2.63.64 3.73L12 12.73 8.56 14.5l.64-3.73-2.7-2.63 3.74-.54L12 4.25Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M17.5 14.75 18.1 16l1.4.7-1.4.7-.6 1.35-.65-1.35-1.35-.7 1.35-.7.65-1.25Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <p class="delivery-timeline__label">Processing</p>
            <p id="processing-date" class="delivery-timeline__date" aria-live="polite"></p>
            <p class="delivery-timeline__hint">We prepare, customize, quality-check, and pack your order.</p>
          </article>

          <article class="delivery-timeline__step delivery-timeline__step--delivery" role="listitem">
            <span class="delivery-timeline__icon-wrap" aria-hidden="true">
              <svg class="delivery-timeline__icon" viewBox="0 0 24 24" fill="none">
                <path d="M4 8.25h9.75v6.75H4V8.25Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                <path d="M13.75 10.5h2.95c.54 0 1.04.25 1.36.68l1.19 1.57c.18.24.28.53.28.83V15h-5.78v-4.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                <path d="M6 17a1.75 1.75 0 1 0 0-3.5A1.75 1.75 0 0 0 6 17Zm11 0a1.75 1.75 0 1 0 0-3.5A1.75 1.75 0 0 0 17 17Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                <path d="M5 10.5H2.75M6 12.75H4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
            </span>
            <p class="delivery-timeline__label">Delivery</p>
            <p id="delivery-date" class="delivery-timeline__date" aria-live="polite"></p>
            <p class="delivery-timeline__hint">Your parcel is dispatched and on the way to your address.</p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <script>
    window.RGDeliveryTimeline = window.RGDeliveryTimeline || (function () {
      const formatter = new Intl.DateTimeFormat('en-US', {
        month: 'short',
        day: '2-digit'
      });

      function addDays(date, days) {
        const nextDate = new Date(date);
        nextDate.setDate(nextDate.getDate() + days);
        return nextDate;
      }

      function normalizeDays(value, fallback) {
        const parsedValue = Math.round(Number(value));
        return Number.isFinite(parsedValue) && parsedValue > 0 ? parsedValue : fallback;
      }

      function isNumericValue(value) {
        return /^-?\d+(\.\d+)?$/.test(String(value || '').trim());
      }

      function normalizeDate(date) {
        const normalizedDate = new Date(date);
        normalizedDate.setHours(12, 0, 0, 0);
        return normalizedDate;
      }

      function parseMetafieldDate(value) {
        const dateValue = String(value || '').trim();

        if (!dateValue || isNumericValue(dateValue)) {
          return null;
        }

        const parsedDate = new Date(dateValue);

        if (!Number.isFinite(parsedDate.getTime())) {
          return null;
        }

        return normalizeDate(parsedDate);
      }

      function formatRange(startDate, endDate) {
        return formatter.format(startDate) + ' - ' + formatter.format(endDate);
      }

      function renderTimeline(root) {
        if (!root) return;

        const fallbackProcessingDays = normalizeDays(root.dataset.processingFallback, 3);
        const metafieldProcessingDate =
          parseMetafieldDate(root.dataset.processingEndDate) ||
          parseMetafieldDate(root.dataset.processingRaw);
        const processingDays = normalizeDays(root.dataset.processingDays, fallbackProcessingDays);
        const deliveryDays = normalizeDays(root.dataset.deliveryDays, 7);
        const today = normalizeDate(new Date());

        const processingStart = addDays(today, 1);
        let processingEnd = metafieldProcessingDate || addDays(today, processingDays);

        if (processingEnd < processingStart) {
          processingEnd = processingStart;
        }

        const deliveryStart = addDays(processingEnd, 1);
        const deliveryEnd = addDays(processingEnd, deliveryDays);

        const orderedDate = root.querySelector('#ordered-date');
        const processingDate = root.querySelector('#processing-date');
        const deliveryDate = root.querySelector('#delivery-date');
        const deliveryRange = root.querySelector('[id^="delivery-range-"]');

        if (orderedDate) {
          orderedDate.textContent = formatter.format(today);
        }

        if (processingDate) {
          processingDate.textContent = metafieldProcessingDate
            ? formatter.format(processingEnd)
            : formatRange(processingStart, processingEnd);
        }

        if (deliveryDate) {
          deliveryDate.textContent = formatRange(deliveryStart, deliveryEnd);
        }

        if (deliveryRange) {
          deliveryRange.textContent = formatRange(today, deliveryEnd);
        }
      }

      function init(scope) {
        const target = scope || document;

        if (target.nodeType === 1 && target.hasAttribute('data-delivery-timeline')) {
          renderTimeline(target);
        }

        if (target.querySelectorAll) {
          target.querySelectorAll('[data-delivery-timeline]').forEach(renderTimeline);
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener(
          'DOMContentLoaded',
          function () {
            init(document);
          },
          { once: true }
        );
      } else {
        init(document);
      }

      document.addEventListener('shopify:section:load', function (event) {
        init(event.target);
      });

      return {
        init: init
      };
    })();

    window.RGDeliveryTimeline.init(document.getElementById('DeliveryTimeline-{{ section.id }}'));
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Delivery Timeline",
  "tag": "section",
  "class": "section-delivery-timeline",
  "limit": 1,
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "number",
      "id": "processing_days",
      "label": "Default Processing Days",
      "default": 3
    },
    {
      "type": "number",
      "id": "delivery_duration",
      "label": "Delivery Duration",
      "default": 7
    },
    {
      "type": "checkbox",
      "id": "show_timeline",
      "label": "Show timeline by default",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Delivery Timeline"
    }
  ]
}
{% endschema %}
