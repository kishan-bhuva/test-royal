{%- liquid
  assign main_image  = section.settings.main_image
  assign eyebrow     = section.settings.eyebrow | default: 'Who We Are'
  assign heading     = section.settings.heading  | default: 'You Desire, We Design It For You'
  assign intro       = section.settings.intro    | default: 'At Royal Gifts & Nameplates, we believe every home and every occasion deserves something truly personal. From premium metal nameplates to heartfelt customized gifts, we craft each piece with love and precision.'
  assign badge_title = section.settings.badge_title | default: 'Crafted with precision'
  assign badge_copy  = section.settings.badge_copy  | default: 'Premium metal & acrylic'
  assign img_alt     = main_image.alt | default: shop.name | escape
-%}

<style>
  .rg-who--{{ section.id }} {
    --who-fh: var(--lux-font-heading, 'Playfair Display', Georgia, serif);
    --who-fb: var(--lux-font-body, 'Inter', system-ui, sans-serif);
    padding: clamp(6rem, 9vw, 10rem) 0;
    background: #0d0d0d;
    position: relative;
    overflow: hidden;
  }

  .rg-who--{{ section.id }}::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 8% 0%,  rgba(198,161,58,0.09), transparent 36%),
      radial-gradient(circle at 92% 100%, rgba(198,161,58,0.05), transparent 28%);
    pointer-events: none;
  }

  /* ── Scroll reveal ── */
  .rg-who--{{ section.id }} .rg-who__rv {
    opacity: 0;
    transform: translateY(2.4rem);
    transition:
      opacity  0.85s cubic-bezier(0.16, 1, 0.3, 1) var(--rv-d, 0s),
      transform 0.85s cubic-bezier(0.16, 1, 0.3, 1) var(--rv-d, 0s);
  }
  .rg-who--{{ section.id }} .rg-who__rv.rg-who__rv--in {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Grid ── */
  .rg-who--{{ section.id }} .rg-who__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(3rem, 5.5vw, 7.5rem);
    align-items: center;
  }

  /* ── Image frame ── */
  .rg-who--{{ section.id }} .rg-who__media {
    position: relative;
    border-radius: 2.8rem;
    overflow: hidden;
    background:
      linear-gradient(150deg, rgba(198,161,58,0.16), rgba(198,161,58,0.02)),
      rgba(5, 12, 10, 0.92);
    border: 0.1rem solid rgba(255,255,255,0.07);
    box-shadow: 0 2.4rem 6rem rgba(0,0,0,0.5);
  }
  .rg-who--{{ section.id }} .rg-who__media::after {
    content: '';
    position: absolute;
    inset: 1.4rem;
    border: 0.1rem solid rgba(198,161,58,0.2);
    border-radius: 1.8rem;
    pointer-events: none;
    z-index: 1;
  }
  .rg-who--{{ section.id }} .rg-who__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    aspect-ratio: 4 / 5;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .rg-who--{{ section.id }} .rg-who__media:hover .rg-who__img {
    transform: scale(1.04);
  }
  .rg-who--{{ section.id }} .rg-who__placeholder {
    aspect-ratio: 4 / 5;
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 50% 16%, rgba(198,161,58,0.08), transparent 32%),
      linear-gradient(180deg, rgba(13,13,13,0.95), rgba(8,8,8,0.99));
    color: var(--rg-gold, #C6A13A);
  }

  /* ── Floating badge ── */
  .rg-who--{{ section.id }} .rg-who__badge {
    position: absolute;
    left: 2.4rem;
    right: 2.4rem;
    bottom: 2.4rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
    padding: 1.4rem 1.8rem;
    border: 0.1rem solid rgba(255,255,255,0.08);
    border-radius: 1.6rem;
    background: rgba(4,10,9,0.82);
    backdrop-filter: blur(8px);
    z-index: 2;
  }
  .rg-who--{{ section.id }} .rg-who__badge-title {
    font: 600 1.15rem/1.2 var(--who-fb);
    letter-spacing: 0.22rem;
    text-transform: uppercase;
    color: var(--rg-gold, #C6A13A);
  }
  .rg-who--{{ section.id }} .rg-who__badge-copy {
    font: 400 1.35rem/1.4 var(--who-fb);
    color: rgba(245,244,239,0.7);
  }

  /* ── Content column ── */
  .rg-who--{{ section.id }} .rg-who__eyebrow {
    display: inline-block;
    font: 700 1.15rem/1 var(--who-fb);
    letter-spacing: 0.3rem;
    text-transform: uppercase;
    color: var(--rg-gold, #C6A13A);
    margin: 0 0 1.6rem;
  }
  .rg-who--{{ section.id }} .rg-who__heading {
    font-family: var(--who-fh);
    font-size: clamp(2.8rem, 3.4vw, 4.2rem);
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: 0.02em;
    color: var(--rg-text, #f5f4ef);
    margin: 0 0 2rem;
  }
  .rg-who--{{ section.id }} .rg-who__intro {
    font: 400 1.65rem/1.82 var(--who-fb);
    color: var(--rg-text-body, rgba(245,244,239,0.75));
    margin: 0 0 3.2rem;
  }

  /* ── Category cards ── */
  .rg-who--{{ section.id }} .rg-who__cats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.4rem;
  }
  .rg-who--{{ section.id }} .rg-who__cat {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 1.4rem;
    padding: 1.8rem;
    background: var(--rg-bg-card, rgba(255,255,255,0.04));
    border: 0.1rem solid var(--rg-border, rgba(198,161,58,0.18));
    border-radius: 1.6rem;
    transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
    overflow: hidden;
  }
  .rg-who--{{ section.id }} .rg-who__cat::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(140deg, rgba(198,161,58,0.1), rgba(198,161,58,0));
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  .rg-who--{{ section.id }} .rg-who__cat:hover {
    border-color: var(--rg-gold, #C6A13A);
    box-shadow: 0 0.6rem 2rem rgba(198,161,58,0.14);
    transform: translateY(-0.35rem);
  }
  .rg-who--{{ section.id }} .rg-who__cat:hover::before { opacity: 1; }

  .rg-who--{{ section.id }} .rg-who__cat-icon {
    flex-shrink: 0;
    width: 4.8rem;
    height: 4.8rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--rg-gold-tint, rgba(198,161,58,0.1));
    border-radius: 1.2rem;
    color: var(--rg-gold, #C6A13A);
    transition: background 0.3s ease, color 0.3s ease;
  }
  .rg-who--{{ section.id }} .rg-who__cat:hover .rg-who__cat-icon {
    background: var(--rg-gold, #C6A13A);
    color: #fff;
  }
  .rg-who--{{ section.id }} .rg-who__cat-icon svg {
    width: 2.4rem;
    height: 2.4rem;
  }
  .rg-who--{{ section.id }} .rg-who__cat-name {
    font: 700 1.5rem/1.3 var(--who-fb);
    color: var(--rg-text, #f5f4ef);
    margin: 0 0 0.4rem;
    letter-spacing: 0.01em;
  }
  .rg-who--{{ section.id }} .rg-who__cat-desc {
    font: 400 1.3rem/1.5 var(--who-fb);
    color: var(--rg-text-muted, rgba(245,244,239,0.5));
    margin: 0;
  }

  /* ── Responsive: tablet ── */
  @media (max-width: 900px) {
    .rg-who--{{ section.id }} .rg-who__inner {
      grid-template-columns: 1fr;
      gap: 4rem;
    }
    .rg-who--{{ section.id }} .rg-who__media {
      max-width: 48rem;
      margin: 0 auto;
    }
  }

  /* ── Responsive: mobile ── */
  @media (max-width: 480px) {
    .rg-who--{{ section.id }} .rg-who__cats  { grid-template-columns: 1fr; }
    .rg-who--{{ section.id }} .rg-who__badge {
      left: 1.6rem;
      right: 1.6rem;
      bottom: 1.6rem;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.4rem;
    }
    .rg-who--{{ section.id }} .rg-who__intro { font-size: 1.5rem; }
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .rg-who--{{ section.id }} .rg-who__rv    { opacity: 1; transform: none; transition: none; }
    .rg-who--{{ section.id }} .rg-who__img,
    .rg-who--{{ section.id }} .rg-who__cat   { transition: none; }
  }
</style>

<section class="rg-who rg-who--{{ section.id }}">
  <div class="page-width">
    <div class="rg-who__inner">

      {%- comment -%} Image column {%- endcomment -%}
      <figure class="rg-who__media rg-who__rv" style="--rv-d:0.05s">
        {%- if main_image != blank -%}
          {{- main_image | image_url: width: 900 | image_tag:
            loading: 'lazy',
            class: 'rg-who__img',
            alt: img_alt -}}
        {%- else -%}
          <div class="rg-who__placeholder">
            <svg width="7.2rem" height="7.2rem" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
              <rect x="3" y="3" width="18" height="18" rx="2"/>
              <path d="M3 9h18M9 21V9"/>
            </svg>
          </div>
        {%- endif -%}
        <figcaption class="rg-who__badge">
          <span class="rg-who__badge-title">{{ badge_title }}</span>
          <span class="rg-who__badge-copy">{{ badge_copy }}</span>
        </figcaption>
      </figure>

      {%- comment -%} Content column {%- endcomment -%}
      <div class="rg-who__content">
        <p class="rg-who__eyebrow rg-who__rv" style="--rv-d:0.2s">{{ eyebrow }}</p>
        <h2 class="rg-who__heading rg-who__rv" style="--rv-d:0.28s">{{ heading }}</h2>
        <p class="rg-who__intro rg-who__rv" style="--rv-d:0.36s">{{ intro }}</p>

        {%- if section.blocks.size > 0 -%}
          <div class="rg-who__cats rg-who__rv" style="--rv-d:0.46s">
            {%- for block in section.blocks -%}
              <div class="rg-who__cat" {{ block.shopify_attributes }}>
                <div class="rg-who__cat-icon" aria-hidden="true">
                  {%- case block.settings.icon_code -%}
                    {%- when 'nameplate' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="7" width="20" height="10" rx="2"/><path d="M7 12h10M7 9.5h4"/></svg>
                    {%- when 'desk' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 17h16M4 13h16M8 17v3M16 17v3"/><rect x="6" y="5" width="12" height="8" rx="1"/></svg>
                    {%- when 'gift' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 12v10H4V12"/><path d="M22 7H2v5h20V7z"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
                    {%- when 'decor' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                    {%- else -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
                  {%- endcase -%}
                </div>
                <div>
                  <p class="rg-who__cat-name">{{ block.settings.name }}</p>
                  <p class="rg-who__cat-desc">{{ block.settings.description }}</p>
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

<script>
(function () {
  var root = document.querySelector('.rg-who--{{ section.id }}');
  if (!root || !window.IntersectionObserver) {
    root && root.querySelectorAll('.rg-who__rv').forEach(function (el) {
      el.classList.add('rg-who__rv--in');
    });
    return;
  }
  var obs = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (!entry.isIntersecting) return;
      entry.target.classList.add('rg-who__rv--in');
      obs.unobserve(entry.target);
    });
  }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
  root.querySelectorAll('.rg-who__rv').forEach(function (el) { obs.observe(el); });
}());
</script>

{% schema %}
{
  "name": "About - Who We Are",
  "settings": [
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Feature image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Who We Are"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You Desire, We Design It For You"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro text",
      "default": "At Royal Gifts & Nameplates, we believe every home and every occasion deserves something truly personal. From premium metal nameplates to heartfelt customized gifts, we craft each piece with love and precision."
    },
    {
      "type": "header",
      "content": "Image badge"
    },
    {
      "type": "text",
      "id": "badge_title",
      "label": "Badge label",
      "default": "Crafted with precision"
    },
    {
      "type": "text",
      "id": "badge_copy",
      "label": "Badge subtext",
      "default": "Premium metal & acrylic"
    }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "select",
          "id": "icon_code",
          "label": "Icon",
          "options": [
            { "value": "nameplate", "label": "Nameplate" },
            { "value": "desk",      "label": "Desk" },
            { "value": "gift",      "label": "Gift" },
            { "value": "decor",     "label": "Home Decor" }
          ],
          "default": "nameplate"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Category name",
          "default": "Metal Nameplates"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Short description",
          "default": "Premium stainless & acrylic designs"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About - Who We Are",
      "blocks": [
        { "type": "category", "settings": { "icon_code": "nameplate", "name": "Metal Nameplates",  "description": "Premium stainless & acrylic designs" } },
        { "type": "category", "settings": { "icon_code": "desk",      "name": "Desk Name Plates",  "description": "Elegant office & corporate plates" } },
        { "type": "category", "settings": { "icon_code": "gift",      "name": "Customized Gifts",  "description": "Personalized for every occasion" } },
        { "type": "category", "settings": { "icon_code": "decor",     "name": "Home Decor",        "description": "Stylish pieces for every space" } }
      ]
    }
  ]
}
{% endschema %}
