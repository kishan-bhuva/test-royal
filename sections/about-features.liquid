{{ 'about-luxury.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="rg-about-section rg-about-features section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="rg-about-header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="rg-about-kicker">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      <h2 class="rg-about-heading">{{ section.settings.heading | escape }}</h2>

      {%- if section.settings.text != blank -%}
        <div class="rg-about-copy rte">
          {{ section.settings.text }}
        </div>
      {%- endif -%}
    </div>

    <div class="rg-about-features__grid">
      {%- for block in section.blocks -%}
        <div class="rg-about-card rg-about-feature" {{ block.shopify_attributes }}>
          <div class="rg-about-feature__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'craft' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.7-3.7a6 6 0 0 1-7.9 7.9l-6.9 6.9a2.1 2.1 0 1 1-3-3l6.9-6.9a6 6 0 0 1 7.9-7.9l-3.7 3.7z"></path>
                </svg>
              {%- when 'personalize' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M12 20h9"></path>
                  <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"></path>
                </svg>
              {%- when 'materials' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M12 2L3 7l9 5 9-5-9-5z"></path>
                  <path d="M3 12l9 5 9-5"></path>
                  <path d="M3 17l9 5 9-5"></path>
                </svg>
              {%- when 'trust' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  <path d="M9 12l2 2 4-4"></path>
                </svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <circle cx="12" cy="12" r="10"></circle>
                  <path d="M12 8v4l3 3"></path>
                </svg>
            {%- endcase -%}
          </div>

          <h3 class="rg-about-feature__title">{{ block.settings.heading | escape }}</h3>
          <p class="rg-about-feature__text">{{ block.settings.text | escape }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About - Features",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why Royal Gifts"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Choose Royal Gifts"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Intro text",
      "default": "<p>Thoughtful design, dependable quality, and personalized products made to feel special.</p>"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "craft",
              "label": "Handcrafted"
            },
            {
              "value": "personalize",
              "label": "Personalized"
            },
            {
              "value": "materials",
              "label": "Premium materials"
            },
            {
              "value": "trust",
              "label": "Trusted"
            }
          ],
          "default": "craft"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Handcrafted Quality"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Every product is crafted with precision and care."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About - Features",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "craft",
            "heading": "Handcrafted Quality",
            "text": "Every product is crafted with precision and care."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "personalize",
            "heading": "Personalized Designs",
            "text": "Unique gifts designed specially for you."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "materials",
            "heading": "Premium Materials",
            "text": "Durable metal and acrylic materials."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "trust",
            "heading": "Trusted by Customers",
            "text": "Loved by customers across India."
          }
        }
      ]
    }
  ]
}
{% endschema %}
