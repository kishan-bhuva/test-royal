{{ 'luxury-theme.css' | asset_url | stylesheet_tag }}

{%- style -%}
  /* --------------------------------------------
     Grid Banner Section
     Visual category navigation with luxury cards
     -------------------------------------------- */
  .lux-grid-banner--{{ section.id }} {
    position: relative;
    padding: 80px 0;
    background:
      radial-gradient(circle at 10% -10%, rgba(198, 167, 94, 0.08) 0%, rgba(198, 167, 94, 0) 44%),
      linear-gradient(160deg, #0a2014 0%, #08140d 100%);
  }

  .lux-grid-banner--{{ section.id }}::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    width: min(1280px, calc(100% - 2rem));
    height: 1px;
    transform: translateX(-50%);
    background: linear-gradient(90deg, rgba(198, 167, 94, 0), rgba(198, 167, 94, 0.6), rgba(198, 167, 94, 0));
  }

  .lux-grid-banner--{{ section.id }} .lux-grid-banner__inner {
    position: relative;
    z-index: 1;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .lux-grid-banner--{{ section.id }} .lux-grid-banner__header {
    max-width: 760px;
    margin: 0 auto 34px;
    text-align: center;
  }

  .lux-grid-banner--{{ section.id }} .lux-grid-banner__heading {
    margin: 0;
    color: #f8f3e7;
    font-family: var(--lux-font-heading);
    font-size: clamp(34px, 3.4vw, 48px);
    line-height: 1.14;
    letter-spacing: 0.02em;
  }

  .lux-grid-banner--{{ section.id }} .lux-grid-banner__subheading {
    margin: 12px 0 0;
    color: #d8d0bf;
    font-family: var(--lux-font-body);
    font-size: clamp(15px, 1.3vw, 18px);
    line-height: 1.65;
  }

  .lux-grid-banner--{{ section.id }} .lux-grid-banner__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 22px;
    align-items: stretch;
  }

  .lux-grid-banner--{{ section.id }} .lux-grid-banner__card {
    position: relative;
    border-radius: 18px;
    overflow: hidden;
    min-height: 320px;
    border: 1px solid rgba(198, 167, 94, 0.35);
    box-shadow: 0 16px 34px rgba(0, 0, 0, 0.38);
    text-decoration: none;
    display: block;
    height: 100%;
    transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;
  }

  .lux-grid-banner--{{ section.id }} .lux-grid-banner__card:hover {
    transform: translateY(-4px);
    border-color: rgba(198, 167, 94, 0.85);
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.5), 0 0 22px rgba(198, 167, 94, 0.24);
  }

  .lux-grid-banner--{{ section.id }} .lux-grid-banner__media {
    position: absolute;
    inset: 0;
  }

  .lux-grid-banner--{{ section.id }} .lux-grid-banner__image,
  .lux-grid-banner--{{ section.id }} .lux-grid-banner__placeholder {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .lux-grid-banner--{{ section.id }} .lux-grid-banner__placeholder {
    fill: rgba(198, 167, 94, 0.24);
    stroke: rgba(198, 167, 94, 0.55);
    background: radial-gradient(circle at 30% 25%, rgba(198, 167, 94, 0.25), rgba(8, 20, 13, 0.95));
  }

  .lux-grid-banner--{{ section.id }} .lux-grid-banner__card:hover .lux-grid-banner__image,
  .lux-grid-banner--{{ section.id }} .lux-grid-banner__card:hover .lux-grid-banner__placeholder {
    transform: scale(1.06);
  }

  .lux-grid-banner--{{ section.id }} .lux-grid-banner__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(4, 10, 7, 0.16) 10%, rgba(4, 10, 7, 0.84) 100%),
      linear-gradient(120deg, rgba(198, 167, 94, 0.14) 0%, rgba(198, 167, 94, 0) 46%);
  }

  .lux-grid-banner--{{ section.id }} .lux-grid-banner__title {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 18px;
    margin: 0;
    color: #f7f3ea;
    font-family: var(--lux-font-heading);
    font-size: clamp(22px, 2vw, 30px);
    line-height: 1.2;
    letter-spacing: 0.01em;
    z-index: 2;
  }

  @media screen and (min-width: 768px) and (max-width: 1199px) {
    .lux-grid-banner--{{ section.id }} {
      padding: 64px 0;
    }

    .lux-grid-banner--{{ section.id }} .lux-grid-banner__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 767px) {
    .lux-grid-banner--{{ section.id }} {
      padding: 44px 0;
    }

    .lux-grid-banner--{{ section.id }} .lux-grid-banner__inner {
      padding: 0 16px;
    }

    .lux-grid-banner--{{ section.id }} .lux-grid-banner__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .lux-grid-banner--{{ section.id }} .lux-grid-banner__card {
      min-height: 260px;
    }
  }
{%- endstyle -%}

<section class="lux-grid-banner lux-grid-banner--{{ section.id }} lux-home-section" data-section-id="{{ section.id }}">
  <div class="lux-grid-banner__inner">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <header class="lux-grid-banner__header" data-lux-reveal>
        {%- if section.settings.heading != blank -%}
          <h2 class="lux-grid-banner__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="lux-grid-banner__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    <div class="lux-grid-banner__grid" role="list">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: '/collections/all' }}" class="lux-grid-banner__card" role="listitem" data-lux-reveal {{ block.shopify_attributes }}>
          <span class="lux-grid-banner__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1000
                | image_tag:
                  class: 'lux-grid-banner__image',
                  loading: 'lazy',
                  widths: '360, 540, 720, 1000',
                  sizes: '(min-width: 1200px) 25vw, (min-width: 768px) 50vw, 100vw',
                  alt: block.settings.title | escape
              }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'lux-grid-banner__placeholder' }}
            {%- endif -%}
          </span>
          <span class="lux-grid-banner__overlay" aria-hidden="true"></span>
          <h3 class="lux-grid-banner__title">{{ block.settings.title }}</h3>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Grid Banner Section",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Browse by Signature Materials"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Explore premium categories crafted for homes, offices, and grand entrances."
    }
  ],
  "blocks": [
    {
      "type": "banner_card",
      "name": "Banner card",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Brass Nameplates"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Grid Banner Section",
      "blocks": [
        {
          "type": "banner_card",
          "settings": {
            "title": "Brass Nameplates"
          }
        },
        {
          "type": "banner_card",
          "settings": {
            "title": "Acrylic Nameplates"
          }
        },
        {
          "type": "banner_card",
          "settings": {
            "title": "LED Nameplates"
          }
        },
        {
          "type": "banner_card",
          "settings": {
            "title": "Corporate Signage"
          }
        }
      ]
    }
  ]
}
{% endschema %}
