{{ 'luxury-theme.css' | asset_url | stylesheet_tag }}

{%- style -%}
  /* Section spacing only. Visual system is controlled by luxury-theme.css */
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="dn-category-showcase dn-category-showcase--{{ section.id }} lux-home-section lux-home-section--browse section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <header class="dn-category-showcase__header" data-lux-reveal>
        {%- if section.settings.heading != blank -%}
          <h2 class="dn-category-showcase__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="dn-category-showcase__subtitle">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    <div class="dn-category-showcase__grid" role="list">
      {%- for block in section.blocks limit: 5 -%}
        <article class="dn-category-showcase__card" role="listitem" data-lux-reveal {{ block.shopify_attributes }}>
          <div class="dn-category-showcase__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 960
                | image_tag:
                  loading: 'lazy',
                  widths: '320, 480, 640, 960',
                  sizes: '(min-width: 990px) calc((100vw - 160px) / 3), (min-width: 750px) calc((100vw - 96px) / 2), calc(100vw - 56px)',
                  class: 'dn-category-showcase__image'
              }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'dn-category-showcase__placeholder' }}
            {%- endif -%}
          </div>

          <div class="dn-category-showcase__content">
            {%- if block.settings.title != blank -%}
              <h3 class="dn-category-showcase__card-title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <p class="dn-category-showcase__card-text">{{ block.settings.description }}</p>
            {%- endif -%}
            {%- if block.settings.link != blank -%}
              <a class="button button--secondary dn-category-showcase__button" href="{{ block.settings.link }}">
                {{ block.settings.button_label | default: 'Explore' }}
              </a>
            {%- endif -%}
          </div>
        </article>
      {%- else -%}
        {%- for i in (1..5) -%}
          <article class="dn-category-showcase__card" role="listitem" data-lux-reveal>
            <div class="dn-category-showcase__media">
              {{ 'collection-1' | placeholder_svg_tag: 'dn-category-showcase__placeholder' }}
            </div>
            <div class="dn-category-showcase__content">
              <h3 class="dn-category-showcase__card-title">Category {{ i }}</h3>
              <p class="dn-category-showcase__card-text">Add an image, short text, and link for this category in Theme Editor.</p>
              <span class="button button--secondary dn-category-showcase__button">Explore</span>
            </div>
          </article>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom Category Showcase",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Browse By Category"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover premium handcrafted collections designed to elevate your entrance."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "category_card",
      "name": "Category card",
      "limit": 5,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Brass Nameplates"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Elegant metallic finishes with lasting craftsmanship."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Explore"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Category Showcase",
      "blocks": [
        {
          "type": "category_card",
          "settings": {
            "title": "Brass Nameplates"
          }
        },
        {
          "type": "category_card",
          "settings": {
            "title": "Acrylic Nameplates"
          }
        },
        {
          "type": "category_card",
          "settings": {
            "title": "Wooden Nameplates"
          }
        },
        {
          "type": "category_card",
          "settings": {
            "title": "Villa Number Plates"
          }
        },
        {
          "type": "category_card",
          "settings": {
            "title": "Corporate Signage"
          }
        }
      ]
    }
  ]
}
{% endschema %}
