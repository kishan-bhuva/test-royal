{{ 'about-luxury.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign story_image_alt = section.settings.heading
  if section.settings.image != blank and section.settings.image.alt != blank
    assign story_image_alt = section.settings.image.alt
  endif
-%}

<section class="rg-about-section rg-about-story section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="rg-about-story__grid">
      <div class="rg-about-story__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag: class: 'rg-about-story__image', loading: 'lazy', alt: story_image_alt
          }}
        {%- else -%}
          <div class="rg-about-media-placeholder rg-about-story__placeholder">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
              <rect x="3" y="4" width="18" height="16" rx="2"></rect>
              <path d="M7 15l3-3 3 3 4-5 3 4"></path>
            </svg>
          </div>
        {%- endif -%}
      </div>

      <div class="rg-about-story__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="rg-about-kicker">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        <h2 class="rg-about-heading">{{ section.settings.heading | escape }}</h2>

        {%- if section.settings.text != blank -%}
          <div class="rg-about-copy rte">
            {{ section.settings.text }}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About - Story",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Brand Story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Story"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Royal Gifts began with a simple idea - to transform ordinary gifts into meaningful keepsakes.</p><p>We noticed that most home decor lacked personalization and emotional value. So we started crafting custom nameplates, metal wall decor, and personalized gifts that reflect each customer's story.</p><p>Today, Royal Gifts proudly delivers handcrafted products across India, combining modern design with traditional craftsmanship.</p>"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 88
    }
  ],
  "presets": [
    {
      "name": "About - Story"
    }
  ]
}
{% endschema %}
