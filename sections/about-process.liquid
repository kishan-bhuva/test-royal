{{ 'about-luxury.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="rg-about-section rg-about-process section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="rg-about-header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="rg-about-kicker">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      <h2 class="rg-about-heading">{{ section.settings.heading | escape }}</h2>

      {%- if section.settings.text != blank -%}
        <div class="rg-about-copy rte">
          {{ section.settings.text }}
        </div>
      {%- endif -%}
    </div>

    <div class="rg-about-process__grid">
      {%- for block in section.blocks -%}
        <div class="rg-about-card rg-about-process__step" {{ block.shopify_attributes }}>
          <div class="rg-about-process__number">{{ forloop.index }}</div>
          <h3 class="rg-about-process__title">{{ block.settings.title | escape }}</h3>
          <p class="rg-about-process__text">{{ block.settings.text | escape }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About - Process",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "How We Craft"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Crafting Process"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Intro text",
      "default": "<p>Each order moves through a careful workflow so the final piece feels premium from design to delivery.</p>"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Design Consultation"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "We understand your style, space, and personalization needs before production begins."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About - Process",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Design Consultation",
            "text": "We understand your style, space, and personalization needs before production begins."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Precision Crafting",
            "text": "Each product is made with careful detailing, premium materials, and clean finishing."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Quality Inspection",
            "text": "Every piece is reviewed for finish, alignment, and durability before dispatch."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Safe Packaging & Delivery",
            "text": "Orders are packed securely so they arrive ready to impress from the first unboxing."
          }
        }
      ]
    }
  ]
}
{% endschema %}
