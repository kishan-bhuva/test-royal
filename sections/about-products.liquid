<style>
  .rg-products {
    padding: 80px 0;
    background: #fff;
  }
  .rg-products__header {
    text-align: center;
    margin-bottom: 48px;
  }
  .rg-products__eyebrow {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--rg-gold);
    margin: 0 0 14px;
  }
  .rg-products__title {
    font-size: clamp(26px, 3vw, 42px);
    font-weight: 700;
    color: var(--rg-text);
    margin: 0 0 12px;
  }
  .rg-products__subtitle {
    font-size: 15px;
    color: var(--rg-text-muted);
    margin: 0;
  }
  .rg-products__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .rg-prod-card {
    border-radius: 14px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 4px 20px rgba(0,0,0,0.07);
    border: 1px solid var(--rg-border);
    transition: box-shadow 0.3s, transform 0.3s;
    text-align: center;
  }
  .rg-prod-card:hover {
    box-shadow: 0 16px 52px rgba(201,162,39,0.17);
    transform: translateY(-5px);
  }
  .rg-prod-card__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1;
    background: var(--rg-bg-skin);
  }
  .rg-prod-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.55s ease;
  }
  .rg-prod-card:hover .rg-prod-card__img {
    transform: scale(1.08);
  }
  .rg-prod-card__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: var(--rg-gold);
    min-height: 200px;
  }
  .rg-prod-card__body {
    padding: 22px 18px 26px;
  }
  .rg-prod-card__title {
    font-size: 16px;
    font-weight: 700;
    color: var(--rg-text);
    margin: 0 0 8px;
  }
  .rg-prod-card__desc {
    font-size: 13px;
    color: var(--rg-text-muted);
    margin: 0 0 20px;
    line-height: 1.55;
  }
  .rg-prod-card__btn {
    display: inline-block;
    padding: 9px 22px;
    color: var(--rg-gold);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-decoration: none;
    border: 1.5px solid var(--rg-gold);
    border-radius: 3px;
    transition: background 0.25s, color 0.25s;
  }
  .rg-prod-card__btn:hover {
    background: var(--rg-gold);
    color: #fff;
  }
  @media (max-width: 900px) {
    .rg-products__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .rg-products__grid { grid-template-columns: repeat(2, 1fr); gap: 16px; }
    .rg-products { padding: 56px 0; }
  }
</style>

<section class="rg-products">
  <div class="page-width">
    <div class="rg-products__header rg-fade">
      <p class="rg-products__eyebrow">{{ section.settings.eyebrow | default: 'What We Offer' }}</p>
      <h2 class="rg-products__title">{{ section.settings.title | default: 'Our Collections' }}</h2>
      <p class="rg-products__subtitle">{{ section.settings.subtitle | default: 'Discover our premium range of personalized products' }}</p>
    </div>

    <div class="rg-products__grid">
      {%- for block in section.blocks -%}
        <div class="rg-prod-card rg-fade" style="transition-delay: {{ forloop.index0 | times: 0.1 }}s" {{ block.shopify_attributes }}>
          <div class="rg-prod-card__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag:
                loading: 'lazy',
                class: 'rg-prod-card__img',
                alt: block.settings.title | escape }}
            {%- else -%}
              <div class="rg-prod-card__placeholder">
                <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
              </div>
            {%- endif -%}
          </div>
          <div class="rg-prod-card__body">
            <h3 class="rg-prod-card__title">{{ block.settings.title }}</h3>
            <p class="rg-prod-card__desc">{{ block.settings.description }}</p>
            <a class="rg-prod-card__btn" href="{{ block.settings.link | default: '/collections/all' }}">View Products</a>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<script>if (window._rgObserveAll) window._rgObserveAll();</script>

{% schema %}
{
  "name": "About - Product Showcase",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "What We Offer"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "Our Collections"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Discover our premium range of personalized products"
    }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Metal Nameplates"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Short description",
          "default": "Premium stainless steel & acrylic designs"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About - Product Showcase",
      "blocks": [
        { "type": "product_card", "settings": { "title": "Metal Nameplates",  "description": "Premium stainless steel & acrylic designs for home entrances" } },
        { "type": "product_card", "settings": { "title": "Photo Lamps",       "description": "Custom LED lamps with your cherished photos and messages" } },
        { "type": "product_card", "settings": { "title": "Couple Gifts",      "description": "Romantic personalized gifts for anniversaries & weddings" } },
        { "type": "product_card", "settings": { "title": "Home Decor",        "description": "Elegant personalized pieces for every corner of your home" } }
      ]
    }
  ]
}
{% endschema %}
