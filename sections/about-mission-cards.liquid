{{ 'about-luxury.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="rg-about-section rg-about-mission section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="rg-about-header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="rg-about-kicker">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      <h2 class="rg-about-heading">{{ section.settings.heading | escape }}</h2>

      {%- if section.settings.text != blank -%}
        <div class="rg-about-copy rte">
          {{ section.settings.text }}
        </div>
      {%- endif -%}
    </div>

    <div class="rg-about-mission__grid">
      {%- for block in section.blocks -%}
        <div class="rg-about-card rg-about-mission__card" {{ block.shopify_attributes }}>
          <h3 class="rg-about-mission__card-title">{{ block.settings.title | escape }}</h3>
          <p class="rg-about-mission__card-text">{{ block.settings.text | escape }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Mission Cards",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Core Beliefs"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Mission & Vision"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Intro text",
      "default": "<p>A focused promise to craft products that feel personal, premium, and lasting.</p>"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    }
  ],
  "max_blocks": 2,
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Mission"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "To create meaningful personalized products that bring beauty and identity into every home."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mission Cards",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "title": "Mission",
            "text": "To create meaningful personalized products that bring beauty and identity into every home."
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Vision",
            "text": "To become India's most trusted brand for personalized gifts and premium nameplates."
          }
        }
      ]
    }
  ]
}
{% endschema %}
